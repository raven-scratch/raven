# The project is checked out on Windows, Linux and macOS. Line endings are
# pinned instead of left to core.autocrlf: tests compare generated bytes (the
# block reference, the SVG costumes embedded in the scaffold), and a CRLF
# checkout would change them.
* text=auto eol=lf

# Archives and images are not text.
*.sb3 binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff2 binary
