// penfont — text and a glyph sheet, drawn with the pen, from tables in the
// project's own arena. This is the library; `examples/raven/penfont` is its
// demo and `font2vm.py` beside this file is what fills `font.rav` in.
//
// What it needs from you:
//
//   1. `src/penfont/font.rav`, generated by `font2vm.py --project <yours>`.
//      That command also copies this file, so the two are one install.
//   2. a hidden sprite with a one-unit transparent costume. The pen draws
//      wherever the sprite is, but the sprite must exist to have a pen.
//   3. `use penfont::engine;` and a call to `draw_text` or `draw_sheet`.
//
// Scratch's pen draws a line and has no fill block, so a glyph is filled the way
// a raster fills any shape: one horizontal line per scan row, worked out once by
// `font2vm.py` at 48 rows to the em, and stored as three numbers a run. Drawing
// is then arithmetic and `set_x`/`set_y`, and this file is all of it.
//
// Every parameter here is spelled `pf_something`, and that is not a style. A
// module is compiled into each target that uses it, a procedure parameter does
// not survive that as a local, and the consuming project's own variables win the
// name: with a parameter called `text`, a project that has `var text` in the
// sprite that draws gets *its* text inside the procedure, and a find asks for
// the wrong glyph. Nothing warns. The prefix is what makes a name this file
// picks unwinnable, so the library cannot be broken by what its caller called
// something.
//
// Two other things here are load-bearing.
//
// **The box.** Scratch does not clip a sprite asked to move past the edge of the
// stage, it *moves it back* — so a run drawn from x = 300 is drawn at x = 225,
// and every row that reaches past the edge piles onto the same column, which is
// a smear rather than a letter. Every run is therefore cut at PF_EDGE_X/PF_EDGE_Y
// first. Those are the tightest fence a costume can give, not the widest, so a
// page inside it fits whatever the sprite is wearing.
//
// **The text language.** Scratch compares two strings case-insensitively, so a
// table cannot be keyed on the character. A capital is marked in the text and
// keyed the same way:
//
//     \cH     a capital H
//     \\      a literal backslash
//     \n      a line break, and a real newline in the string does the same
//
// `font_chars` is sorted by the lowercased key, which is the order Scratch's `<`
// compares in, so `find_glyph` can binary-search it. It cannot use `index_of`:
// that is a generated procedure that walks the list one item at a time.
//
// A table built with `font2vm.py --ligatures` also carries the font's own
// ligatures, keyed by the whole sequence -- `->`, `==`, `<=>` -- and `draw_text`
// takes the longest key that starts where it is, up to `PF_LIG_MAX` characters.
// Nothing else in here has to know they exist: a ligature is a key like any
// other, one that happens to be several characters long.

use penfont::font;

/// The box the pen may be moved inside. A run outside it is cut, never asked
/// for: see the note above about what Scratch does to a sprite past the edge.
pub const PF_EDGE_X: num = 225;
pub const PF_EDGE_Y: num = 165;

/// The code units either side of the surrogate range, which is how this tells a
/// character outside the basic plane from one inside it.
///
/// A Scratch string is a string of UTF-16 code units and `letter of` reads one
/// of them, so an icon at U+F0001 arrives as two halves and neither half is a
/// character. The two halves are put back together -- and the way to recognise
/// the first half is that it lies between these two characters. They are written
/// as the boundaries rather than as something in the range because a `\u{D800}`
/// is not a character and raven, spelling one, refuses it: `char::from_u32` has
/// nothing to return.
pub const ASTRAL_LO: str = "\u{D7FF}";
pub const ASTRAL_HI: str = "\u{E000}";

/// Baseline to baseline, in ems. This is the font's own leading: the tallest ink
/// the tables carry reaches about 1.06 em above the baseline and 0.3 below, so a
/// line that would be comfortable for Latin alone collides with a CJK one.
pub const PF_LEAD: num = 1.32;

/// The longest key `draw_text` looks for, which is the longest ligature the
/// table may carry. A ligature is a key of several characters that one glyph
/// draws: `->` and `==`, the status labels a programming font draws for
/// `[ERROR]` and `[TODO]`, and the runs it extends, `---`. The generator reads
/// this number out of this file and writes no key longer than it, so the two
/// agree by construction; 1 is a table with no ligatures and searches for none.
pub const PF_LIG_MAX: num = 16;

/// What a sheet page holds, and where. Twelve across and eight down at these
/// pitches is 432 by 238 inside a box 450 wide, which leaves the top and the
/// bottom for the two lines that say where in the inventory you are.
pub const PF_COLS: num = 12;
pub const PF_ROWS: num = 8;
pub const PF_SHEET_CELLS: num = 96;
pub const PF_CELL: num = 36;
pub const PF_STEP: num = 34;
pub const PF_SHEET_LEFT: num = -218;
pub const PF_SHEET_TOP: num = 130;
pub const PF_SHEET_EM: num = 22;
pub const PF_SHEET_SAY: num = -136;
pub const PF_SHEET_TAIL: num = -156;
pub const PF_SHEET_SAY_EM: num = 16;

/// The pen width a size wants: one unit an em is FONT_ROWS units of scan row, so
/// `ceil` of the scale is the smallest pen that leaves no white between two rows.
///
/// A `proc` rather than an `fn` because it has to clamp, and an `fn` body is one
/// expression with no conditional in it. It is called once a page, not once a
/// glyph, so the call costs nothing that matters. It is `pub` because a module
/// exports its public items and drops the rest, so a private one would be gone
/// by the time another procedure in the same file called it.
pub proc stroke_width(pf_em: num) -> num warp {
    let pen: num = ceil(pf_em / FONT_ROWS);
    if pen < 1 {
        pen = 1;
    }
    return pen;
}

/// The index of a key in the font, or 0 for a character it does not carry.
pub proc find_glyph(pf_key: str) -> num warp {
    let lo: num = 1;
    let hi: num = font_chars.len();
    let hit: num = 0;
    repeat_until lo > hi || hit > 0 {
        let mid: num = floor((lo + hi) / 2);
        let probe: str = font_chars[mid];
        if probe == pf_key {
            hit = mid;
        } else {
            // `<` is typed for numbers, so the two keys go through `num()`,
            // which is a retype and no block: the block Scratch gets still
            // compares the two strings -- lowercased, which is the order the
            // table is sorted in.
            if num(probe) < num(pf_key) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
    }
    return hit;
}

/// The glyph a piece of text starts with, read the way the renderer reads it: a
/// `\c` in front of the character makes it a capital. 0 if the font has none.
///
/// This is what a find in the sheet is built on, and it is the same search the
/// text goes through, so a character that draws draws at the page it finds.
pub proc glyph_of(pf_text: str) -> num warp {
    if operators::length(pf_text) == 0 {
        return 0;
    }
    let c: str = operators::letter_of(1, pf_text);
    if num(c) > num(ASTRAL_LO) && num(c) < num(ASTRAL_HI) {
        return find_glyph(operators::join(c, operators::letter_of(2, pf_text)));
    }
    if c == "\\" {
        return find_glyph(operators::join("\\c", operators::letter_of(2, pf_text)));
    }
    return find_glyph(c);
}

/// Which sheet page a glyph is on.
pub proc glyph_page(pf_g: num) -> num warp {
    return floor((pf_g - 1) / PF_SHEET_CELLS) + 1;
}

/// How many pages the sheet has.
pub proc sheet_pages() -> num warp {
    return glyph_page(font_chars.len());
}

/// One glyph's runs, as pen lines, at a scale and a pen width worked out once by
/// the caller.
///
/// A run is inset by half the pen at each end, so the ink covers the columns the
/// row named and no more. A run narrower than the pen cannot be drawn that way
/// and becomes the dot its round cap makes instead, which is what a stem thinner
/// than a pixel has to be.
///
/// The x and the y are both set while the pen is up, so the move between two
/// rows is an x move then a y move and never a diagonal.
pub proc ink_glyph(pf_g: num, pf_x: num, pf_y: num, pf_scale: num, pf_pen: num) warp {
    let first: num = font_at[pf_g];
    let count: num = font_runs[pf_g];
    let half: num = pf_pen / 2;
    let k: num = 0;
    repeat count {
        let o: num = first + 3 * k;
        let row: num = font_run[o];
        let a: num = font_run[o + 1];
        let b: num = font_run[o + 2];
        let top: num = pf_y + (row + 0.5) * pf_scale;
        let from: num = pf_x + a * pf_scale + half;
        let to: num = pf_x + b * pf_scale - half;
        if to <= from {
            from = pf_x + (a + b) * pf_scale / 2;
            to = from + 0.05;
        }
        if from < -PF_EDGE_X {
            from = -PF_EDGE_X;
        }
        if to > PF_EDGE_X {
            to = PF_EDGE_X;
        }
        if to > from && top > -PF_EDGE_Y && top < PF_EDGE_Y {
            motion::set_x(from);
            motion::set_y(top);
            pen::pen_down();
            motion::set_x(to);
            pen::pen_up();
        }
        k += 1;
    }
}

/// One glyph, from the left of its pen origin, on its baseline. The size is the
/// em box, which is what the font's numbers are fractions of.
pub proc glyph(pf_g: num, pf_x: num, pf_y: num, pf_em: num, pf_colour: str) warp {
    pen::set_pen_color_to_color(num(pf_colour));
    let pen: num = stroke_width(pf_em);
    pen::set_pen_size_to(pen);
    ink_glyph(pf_g, pf_x, pf_y, pf_em / FONT_ROWS, pen);
}

/// A block of text from its top-left baseline, wrapped inside `pf_wide`.
///
/// The wrap is per character, which is what a line of Chinese wants and is all a
/// line of English gets: a long word is broken rather than moved down. A width
/// of 0 is no wrap at all. A character the font does not carry advances half an
/// em and draws nothing, so a missing glyph leaves a gap rather than a hole in
/// the line.
pub proc draw_text(pf_content: str, pf_x: num, pf_y: num, pf_em: num, pf_colour: str, pf_wide: num) warp {
    // A colour input is a number to raven and a `#rrggbb` string to Scratch,
    // which parses one the same way it parses the picker's own value.
    pen::set_pen_color_to_color(num(pf_colour));
    let scale: num = pf_em / FONT_ROWS;
    let pen: num = stroke_width(pf_em);
    pen::set_pen_size_to(pen);
    let lead: num = pf_em * PF_LEAD;
    let px: num = pf_x;
    let py: num = pf_y;
    let i: num = 1;
    let n: num = operators::length(pf_content);
    let cap: num = 0;
    repeat_until i > n {
        let c: str = operators::letter_of(i, pf_content);
        let step: num = 1;
        let show: num = 1;
        // A character outside the basic plane is two UTF-16 code units and this
        // reads one at a time, so the pair is put back together: the key for
        // such a glyph is the whole pair, and half of one is not a character.
        if num(c) > num(ASTRAL_LO) && num(c) < num(ASTRAL_HI) {
            c = operators::join(c, operators::letter_of(i + 1, pf_content));
            step = 2;
        }
        // A string in raven can hold a real line break as easily as the two
        // characters `\n`, and a line is written both ways, so both break.
        if c == "\n" || c == "\r" {
            px = pf_x;
            py = py - lead;
            cap = 0;
            show = 0;
        }
        if c == "\\" {
            // `letter_of` past the end is the empty string, so a trailing
            // backslash falls through to being the backslash glyph.
            let d: str = operators::letter_of(i + 1, pf_content);
            if d == "c" || d == "C" {
                cap = 1;
                show = 0;
                step = 2;
            } else {
                if d == "n" || d == "N" {
                    px = pf_x;
                    py = py - lead;
                    cap = 0;
                    show = 0;
                    step = 2;
                } else {
                    if d == "\\" {
                        step = 2;
                    }
                }
            }
        }
        if show == 1 {
            // A ligature is a key of several characters that one glyph draws,
            // and the longest key that starts here wins: `===` is its own key
            // rather than `==` and then `=`. The search stops at an escape or a
            // break, because neither can stand in a key, and at the end of the
            // text.
            //
            // It also costs nothing for a character no key begins with, and a
            // table with no ligatures has none: the keys are sorted, so the one
            // after a character is that character again exactly when some
            // longer key starts with it. A right single character is the whole
            // test, and nothing is searched when it fails.
            let key: str = c;
            let held: num = cap;
            if cap == 1 {
                key = operators::join("\\c", c);
            }
            let g: num = find_glyph(key);
            if held == 0 && step == 1 && c != "\\" && g > 0 && g < font_chars.len() && PF_LIG_MAX > 1 {
                if operators::letter_of(1, font_chars[g + 1]) == c {
                    let run: str = "";
                    let k: num = 0;
                    let stop: num = 0;
                    repeat_until k >= PF_LIG_MAX || stop == 1 {
                        let d: str = operators::letter_of(i + k, pf_content);
                        if d == "" || d == "\\" || d == "\n" || d == "\r" {
                            stop = 1;
                        } else {
                            run = operators::join(run, d);
                            k = k + 1;
                            if k > 1 {
                                let hit: num = find_glyph(run);
                                if hit > 0 {
                                    g = hit;
                                    step = k;
                                }
                            }
                        }
                    }
                }
            }
            cap = 0;
            let adv: num = pf_em / 2;
            if g > 0 {
                adv = font_adv[g] * scale;
            }
            if pf_wide > 0 && px > pf_x && px + adv > pf_x + pf_wide {
                px = pf_x;
                py = py - lead;
            }
            if g > 0 {
                ink_glyph(g, px, py, scale, pen);
            }
            px = px + adv;
        }
        i = i + step;
    }
}

/// One straight pen line from a to b, set while the pen is up.
pub proc stroke(pf_x0: num, pf_y0: num, pf_x1: num, pf_y1: num) warp {
    motion::set_x(pf_x0);
    motion::set_y(pf_y0);
    pen::pen_down();
    motion::set_x(pf_x1);
    motion::set_y(pf_y1);
    pen::pen_up();
}

/// The sheet: every glyph the font has, `PF_COLS` by `PF_ROWS` to a page, in the order
/// the table is keyed, with the page number under it and `pf_mark` -- a glyph
/// index, or 0 -- ringed in the accent ink.
///
/// A cell is an index and nothing else: no lookup, no key, no string. That is the
/// point of the table being an inventory rather than a dictionary, and it is what
/// makes browsing fifteen thousand glyphs cost nothing.
///
/// `pf_note` is a line drawn under the page in the accent ink; the empty string
/// draws nothing. It is where a find says what it found.
pub proc draw_sheet(pf_page: num, pf_mark: num, pf_note: str, pf_colour: str, pf_accent: str) warp {
    pen::clear();
    let em: num = PF_SHEET_EM;
    let scale: num = em / FONT_ROWS;
    let pen: num = stroke_width(em);
    pen::set_pen_size_to(pen);
    let total: num = font_chars.len();
    let first: num = (pf_page - 1) * PF_SHEET_CELLS + 1;
    let k: num = 0;
    repeat PF_SHEET_CELLS {
        let g: num = first + k;
        if g <= total {
            let cx: num = PF_SHEET_LEFT + 6 + (k % PF_COLS) * PF_CELL;
            let cy: num = PF_SHEET_TOP - floor(k / PF_COLS) * PF_STEP;
            if g == pf_mark {
                pen::set_pen_color_to_color(num(pf_accent));
            } else {
                pen::set_pen_color_to_color(num(pf_colour));
            }
            ink_glyph(g, cx, cy, scale, pen);
            if g == pf_mark {
                stroke(cx - 4, cy - 5, cx + PF_CELL - 10, cy - 5);
                stroke(cx + PF_CELL - 10, cy - 5, cx + PF_CELL - 10, cy + 27);
                stroke(cx + PF_CELL - 10, cy + 27, cx - 4, cy + 27);
                stroke(cx - 4, cy + 27, cx - 4, cy - 5);
            }
        }
        k += 1;
    }
    pen::set_pen_size_to(1);
    draw_text(f"glyphs {first} to {first + PF_SHEET_CELLS - 1} of {total}   page {pf_page} of {sheet_pages()}",
              PF_SHEET_LEFT, PF_SHEET_SAY, PF_SHEET_SAY_EM, pf_colour, 0);
    if operators::length(pf_note) > 0 {
        draw_text(pf_note, PF_SHEET_LEFT, PF_SHEET_TAIL, PF_SHEET_SAY_EM, pf_accent, 0);
    }
}
