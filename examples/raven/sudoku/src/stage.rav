// Sudoku — the stage owns the backdrop and the few values both sprites read.
//
// The board and the HUD are two sprites on one pen layer, so they cannot share a
// sprite-local variable: the board clears the layer and draws the grid, then
// broadcasts `hud`, and the HUD stamps its text on top of what the board left.
// Everything the HUD has to read is declared here, where projects put state that
// more than one target sees.
//
// None of these is a Scratch variable a program can name — a `pub var` is a cell
// of the project's arena — so nothing here appears in the editor's variable list
// and no monitor is declared.

stage {
    costume "backdrop" = "assets/backdrop.svg";

    /// 0 the menu, 1 playing, 2 solved, 3 out of tries, 4 generating.
    pub var state: num = 0;

    /// Which difficulty the menu is on, 1 to 3.
    pub var sel: num = 1;

    /// How many cells the puzzle started with, and how many wrong entries are
    /// left before the run is over.
    pub var clues: num = 81;
    pub var tries: num = 3;
    pub var mistakes: num = 0;

    /// How long the winning run took, in whole seconds.
    pub var seconds: num = 0;

    /// The board clears the pen layer and draws, then asks for the text.
    broadcast "hud";

    /// A finished line or box asks for its wave on this.
    ///
    /// The wave waits between steps to animate, and a key hat that is still
    /// running swallows the next press of that key — so the animation cannot run
    /// on the thread that handled the key. Broadcasting hands it to a thread of
    /// its own and lets the key handler end.
    broadcast "wave";

    /// The background loop, which is `tools/sounds.mjs`'s output. Regenerate it
    /// rather than editing it.
    sound "ambient" = "assets/ambient.wav";

    /// The loop plays for as long as the project runs.
    ///
    /// `play_until_done` waits for the sound it names, so a `forever` around it is
    /// the loop — a Scratch sound cannot be told to loop by itself. This script
    /// keeps no `let` on purpose: a stage script that keeps one and a sprite script
    /// that keeps one both want a list called `_stack1`, and the stage's lists are
    /// project-wide, so the second is refused as shadowing the first. A script
    /// with no locals is safe anywhere.
    on flag_clicked {
        forever {
            sound::play_until_done(Sound::AMBIENT);
        }
    }
}
