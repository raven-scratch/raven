// The board: the generator, the game and every pixel of the drawing.
//
// One sprite owns the whole game. It stamps its own costumes onto the pen layer
// and redraws that layer in a single `warp`, so a frame is one clear and about
// ninety stamps and there is no clone to leak state.
//
// The generator is the interesting part, and it is a construction rather than a
// search. `build_solution` makes a finished grid by shuffling a known-valid
// pattern — the bands, the stacks and the nine digits are permuted, and each of
// those keeps a grid valid. `dig` then removes cells one at a time and keeps a
// removal only when the removed value is still *forced* by the cells that
// remain: either it is the only digit its cell can hold, or it is the only place
// its digit can go in one of its row, column and box.
//
// That single test is enough to make the whole puzzle solvable by those two
// rules alone. The removals run in some order, and replaying them backwards is
// the solve: the last cell removed was forced by the clues that were left at
// that moment, which is exactly the clue set the player starts with, so the
// solver can fill it, and then the cell before it, and so on. No guess is ever
// needed, and no backtracking search is ever run — not while generating and not
// while solving, because the puzzle is unique by construction: every step of the
// solve is forced, so there is only one grid it can reach.
//
// Nothing here holds a grid in a nested list. A board is 81 numbers in one flat
// list and a cell's row, column and box are three lookups in tables built once
// per run, so an index never has to be divided.

sprite "Board" {
    costume "dot" = "assets/dot.svg";
    costume "cursor" = "assets/cursor.svg";
    costume "match" = "assets/match.svg";
    costume "flash" = "assets/flash.svg";
    costume "given1" = "assets/given1.svg";
    costume "given2" = "assets/given2.svg";
    costume "given3" = "assets/given3.svg";
    costume "given4" = "assets/given4.svg";
    costume "given5" = "assets/given5.svg";
    costume "given6" = "assets/given6.svg";
    costume "given7" = "assets/given7.svg";
    costume "given8" = "assets/given8.svg";
    costume "given9" = "assets/given9.svg";
    costume "user1" = "assets/user1.svg";
    costume "user2" = "assets/user2.svg";
    costume "user3" = "assets/user3.svg";
    costume "user4" = "assets/user4.svg";
    costume "user5" = "assets/user5.svg";
    costume "user6" = "assets/user6.svg";
    costume "user7" = "assets/user7.svg";
    costume "user8" = "assets/user8.svg";
    costume "user9" = "assets/user9.svg";

    /// One file per effect, which is `tools/sounds.mjs`'s output. Regenerate them
    /// rather than editing them.
    ///
    /// A sound is *started* by `play`, not waited for, so an effect returns at
    /// once and can be asked for from the key handler that caused it. The note
    /// blocks of the Music extension cannot: those wait for the length of the
    /// note, and Scratch drops a key press that arrives while a thread from the
    /// same key hat is still running.
    sound "good" = "assets/good.wav";
    sound "bad" = "assets/bad.wav";
    sound "unit" = "assets/unit.wav";
    sound "win" = "assets/win.wav";
    sound "lose" = "assets/lose.wav";
    sound "move" = "assets/move.wav";

    /// One cell, and the grid, in stage units.
    ///
    /// The stage is 480 by 360 and the board takes the left of it: 9 cells of 26
    /// is 234, so the grid runs from -228 to 6 and leaves 12 units of margin on
    /// the left, 234 of column on the right, and 63 above and below. The board
    /// stays vertically centred, which is what lets the HUD use the right-hand
    /// column without the two ever meeting.
    const CELL: num = 26;

    /// Where the top-left corner of the grid sits.
    const LEFT: num = -228;
    const TOP: num = 117;

    /// How many wrong entries a run survives. The remaining count lives on the
    /// stage as `tries`, because the HUD prints it.
    const TRIES: num = 3;

    /// The cell the player is on, 1..81.
    var cursor: num = 1;

    /// The wave that runs when a line, a box or the whole board is finished.
    ///
    /// `flash_cells` holds the cells being tinted and `flash_order` holds how
    /// many steps after the first each one starts, so the tint sweeps along the
    /// group instead of appearing all at once. `flash_step` is the animation's
    /// clock, and a negative value means no wave is running — which is what
    /// `redraw` reads before it draws any tint at all.
    var flash_cells: list<num> = [];
    var flash_order: list<num> = [];
    var flash_step: num = -1;

    /// The waves waiting to be played, and `BOARD` as the entry that means the
    /// whole board rather than one of the twenty-seven units.
    var queue: list<num> = [];
    const BOARD: num = 100;

    /// Which of the twenty-seven units have already had their wave, so a cell
    /// that is cleared and filled again does not set one off twice.
    var marked: list<num> = [];

    /// The finished grid the puzzle was cut from, and the puzzle itself.
    var solution: list<num> = [];
    var puzzle: list<num> = [];

    /// What the board shows and whether each cell is a given: 81 of each.
    var cells: list<num> = [];
    var locked: list<num> = [];

    /// The clue count each difficulty aims for, indexed by the level the menu
    /// chose: the first item is easy, so `targets[level]` is the entry's number.
    ///
    /// The aim is not a promise. A pass stops when no cell left in it is forced,
    /// which the randomness of the order decides, so a deal can come out a few
    /// clues richer than the number here. The generator never removes a cell it
    /// cannot justify, so it takes what it can get.
    var targets: list<num> = [50, 44, 40];

    // The tables every cell lookup goes through.
    //
    // `rows`, `cols` and `boxes` answer "where is this cell" in one index, and
    // `peers` holds each cell's twenty companions — its row, its column and its
    // box, without repeats — twenty in a row, so `peers[(i - 1) * 20 + j]` is a
    // single list read. `units` holds the nine cells of each of the twenty-seven
    // units, in the order the three `*_uid` functions name them: rows first,
    // then columns, then boxes.
    var rows: list<num> = [];
    var cols: list<num> = [];
    var boxes: list<num> = [];
    var peers: list<num> = [];
    var units: list<num> = [];

    // Scratch's own scratch space, used by one routine at a time.
    var order: list<num> = [];
    var temp3: list<num> = [];
    var temp9: list<num> = [];
    var row_order: list<num> = [];
    var col_order: list<num> = [];

    // ---------------------------------------------------------------------
    // Index arithmetic
    // ---------------------------------------------------------------------

    fn row_of(i: num) -> num {
        floor((i - 1) / 9)
    }

    fn col_of(i: num) -> num {
        (i - 1) % 9
    }

    fn cell_x(c: num) -> num {
        LEFT + c * CELL + CELL / 2
    }

    fn cell_y(r: num) -> num {
        TOP - r * CELL - CELL / 2
    }

    /// Whether two cells share a row, a column or a box, which is what makes
    /// them peers.
    fn same_unit(a: num, b: num) -> bool {
        rows[a] == rows[b] || cols[a] == cols[b] || boxes[a] == boxes[b]
    }

    fn row_uid(i: num) -> num {
        rows[i] + 1
    }

    fn col_uid(i: num) -> num {
        cols[i] + 10
    }

    fn box_uid(i: num) -> num {
        boxes[i] + 19
    }

    // ---------------------------------------------------------------------
    // The tables
    // ---------------------------------------------------------------------

    /// Build the five lookup tables. This runs once per run of the project, and
    /// every loop in the generator and in the solver is a read of one of them.
    proc build_tables() warp {
        rows.clear();
        cols.clear();
        boxes.clear();
        for i in 0..81 {
            let r = floor(i / 9);
            let c = i % 9;
            rows.push(r);
            cols.push(c);
            boxes.push(floor(r / 3) * 3 + floor(c / 3));
        }

        units.clear();
        for r in 0..9 {
            for c in 0..9 {
                units.push(r * 9 + c + 1);
            }
        }
        for c in 0..9 {
            for r in 0..9 {
                units.push(r * 9 + c + 1);
            }
        }
        for b in 0..9 {
            let br = floor(b / 3);
            let bc = b % 3;
            for k in 0..9 {
                units.push((br * 3 + floor(k / 3)) * 9 + bc * 3 + (k % 3) + 1);
            }
        }

        peers.clear();
        for a in 1..=81 {
            for b in 1..=81 {
                if a != b {
                    if same_unit(a, b) {
                        peers.push(b);
                    }
                }
            }
        }
    }

    // ---------------------------------------------------------------------
    // The generator
    // ---------------------------------------------------------------------

    /// Fill `temp3` with the numbers 1..3 in a random order.
    proc shuffle3() warp {
        temp3.clear();
        temp3.push(1);
        temp3.push(2);
        temp3.push(3);
        let i = 2;
        repeat_until i > 3 {
            let j = operators::random(1, i);
            let held = temp3[i];
            temp3[i] = temp3[j];
            temp3[j] = held;
            i += 1;
        }
    }

    /// Fill `temp9` with the digits 1..9 in a random order. The digits are
    /// permuted as a set, which is what keeps a grid valid.
    proc shuffle9() warp {
        temp9.clear();
        for i in 1..=9 {
            temp9.push(i);
        }
        let i = 2;
        repeat_until i > 9 {
            let j = operators::random(1, i);
            let held = temp9[i];
            temp9[i] = temp9[j];
            temp9[j] = held;
            i += 1;
        }
    }

    /// A random ordering of the rows that keeps each band of three together, so
    /// the grid stays valid.
    proc pick_rows() warp {
        row_order.clear();
        let band = 0;
        repeat_until band > 2 {
            shuffle3();
            let k = 1;
            repeat_until k > 3 {
                row_order.push(band * 3 + temp3[k] - 1);
                k += 1;
            }
            band += 1;
        }
    }

    /// The same for the columns, keeping each stack together.
    proc pick_cols() warp {
        col_order.clear();
        let stack = 0;
        repeat_until stack > 2 {
            shuffle3();
            let k = 1;
            repeat_until k > 3 {
                col_order.push(stack * 3 + temp3[k] - 1);
                k += 1;
            }
            stack += 1;
        }
    }

    /// A finished grid, from one that is already valid.
    ///
    /// The pattern `(R * 3 + R / 3 + C) % 9` is a solved Sudoku for 0-based `R`
    /// and `C`. Permuting whole bands of rows, whole stacks of columns and the
    /// nine digits are the three transformations that keep every grid valid, so
    /// composing them with a random one of each gives a random finished grid
    /// without a single wrong placement to take back.
    proc build_solution() warp {
        pick_rows();
        pick_cols();
        shuffle9();
        solution.clear();
        for r in 0..9 {
            for c in 0..9 {
                let row = row_order[r + 1];
                let col = col_order[c + 1];
                solution.push(temp9[(row * 3 + floor(row / 3) + col) % 9 + 1]);
            }
        }
    }

    /// Whether cell `i` can still take digit `d`: no peer of it holds `d`.
    proc could_hold(i: num, d: num) -> bool warp {
        for j in 0..20 {
            let p = peers[(i - 1) * 20 + j + 1];
            if puzzle[p] == d {
                return false;
            }
        }
        return true;
    }

    /// Whether digit `d` can go nowhere but cell `i` in unit `uid`, which makes
    /// `i` the only home for it there.
    proc only_home(uid: num, i: num, d: num) -> bool {
        let rivals = 0;
        for k in 1..=9 {
            let p = units[(uid - 1) * 9 + k];
            if p != i {
                if puzzle[p] == 0 {
                    if could_hold(p, d) {
                        rivals += 1;
                    }
                }
            }
        }
        return rivals == 0;
    }

    /// Whether cell `i` is *forced* to hold `d` by the cells still in `puzzle`.
    ///
    /// This is the whole guarantee of the generator: a removal survives only
    /// when the value it took away is the only candidate its cell has, or the
    /// only place its digit can go in one of its three units.
    ///
    /// The first test counts the digits *no peer holds*, rather than adding up
    /// a bit per peer. Two peers can hold the same digit, and a running sum
    /// counts it twice — which can make a two-candidate cell look like a
    /// one-candidate cell and let a guess through. A count cannot.
    proc forced(i: num, d: num) -> bool warp {
        let open = 0;
        let x = 1;
        repeat_until x > 9 || open > 1 {
            let held = 0;
            for j in 0..20 {
                let p = peers[(i - 1) * 20 + j + 1];
                if puzzle[p] == x {
                    held = 1;
                }
            }
            if held == 0 {
                open += 1;
            }
            x += 1;
        }
        if open == 1 {
            return true;
        }
        if only_home(row_uid(i), i, d) {
            return true;
        }
        if only_home(col_uid(i), i, d) {
            return true;
        }
        return only_home(box_uid(i), i, d);
    }

    /// A random ordering of the 81 cells, for the order they are dug in.
    proc shuffle_order() warp {
        let i = 2;
        repeat_until i > order.len() {
            let j = operators::random(1, i);
            let held = order[i];
            order[i] = order[j];
            order[j] = held;
            i += 1;
        }
    }

    /// Cut the puzzle: start from the finished grid and take cells away, keeping
    /// each removal only while the value it removed is still forced. Stop once
    /// the puzzle is down to `target` clues.
    ///
    /// A pass can stall on the order it happened to walk: a cell that is not
    /// forced yet may become forced once a later cell goes. So a pass that
    /// removed anything is followed by another, in a fresh random order, and
    /// the digging only stops when a whole pass takes nothing away. Every
    /// removal is still forced at the moment it happens, so the guarantee is
    /// untouched — a later pass can only make a cell forced that was not before.
    proc dig(target: num) warp {
        puzzle.clear();
        for i in 1..=81 {
            puzzle.push(solution[i]);
        }

        clues = 81;
        let pass = 0;
        let done = 0;
        repeat_until done == 1 || clues <= target || pass >= 8 {
            pass += 1;
            order.clear();
            for i in 1..=81 {
                order.push(i);
            }
            shuffle_order();

            let removed = 0;
            let k = 1;
            repeat_until k > 81 {
                if clues > target {
                    let i = order[k];
                    if puzzle[i] != 0 {
                        let held = puzzle[i];
                        puzzle[i] = 0;
                        if forced(i, held) {
                            clues -= 1;
                            removed += 1;
                        } else {
                            puzzle[i] = held;
                        }
                    }
                }
                k += 1;
            }
            if removed == 0 {
                done = 1;
            }
        }
        open_units();
    }

    /// Whether all nine cells of unit `uid` are clues.
    proc full_unit(uid: num) -> bool warp {
        for k in 1..=9 {
            if puzzle[units[(uid - 1) * 9 + k]] == 0 {
                return false;
            }
        }
        return true;
    }

    /// Take one cell out of a unit that is still all clues.
    ///
    /// A pass stops as soon as the clue count reaches the target, so a unit the
    /// walk never happened to open can survive with every one of its nine cells
    /// filled — a finished line or box handed to the player, which is most of
    /// the puzzle's work given away. Opening one is always possible, and the
    /// reason is worth writing down: with the unit full, any of its cells
    /// becomes the only empty cell in that unit, so the hidden-single test
    /// passes for it and the removal cannot cost the guarantee.
    proc open_units() warp {
        let uid = 1;
        repeat_until uid > 27 {
            if full_unit(uid) {
                order.clear();
                for k in 1..=9 {
                    order.push(units[(uid - 1) * 9 + k]);
                }
                shuffle_order();
                let k = 1;
                let opened = 0;
                repeat_until k > 9 || opened == 1 {
                    let i = order[k];
                    let held = puzzle[i];
                    puzzle[i] = 0;
                    if forced(i, held) {
                        clues -= 1;
                        opened = 1;
                    } else {
                        puzzle[i] = held;
                    }
                    k += 1;
                }
            }
            uid += 1;
        }
    }

    // ---------------------------------------------------------------------
    // The wave
    // ---------------------------------------------------------------------

    /// How long one cell's tint lasts, in steps, and how many steps apart two
    /// neighbours in a group start. The whole group is `SPAN + 8 * STAGGER`
    /// steps, which at a step of `BEAT` seconds is a little over half a second:
    /// long enough to see the sweep, short enough not to hold up the game.
    const SPAN: num = 14;
    const STAGGER: num = 1.2;
    const BEAT: num = 0.03;

    /// Tint the cells in `flash_cells`, then leave the layer as it was.
    ///
    /// Nothing about the colour is a costume: the tile is one flat blue and the
    /// strength of the tint is the sprite's *ghost* effect, computed per cell
    /// from the clock. The ramp is a half sine, which is what puts the fast part
    /// of the transition in the middle — the tint eases away from nothing,
    /// crosses blue quickly, and eases back out, instead of switching on.
    ///
    /// This waits between steps, so it must not be `warp`: a warp procedure
    /// suppresses the screen refresh and the whole wave would land as one frame.
    ///
    /// There is no guard against a wave arriving while one is running, and that
    /// is deliberate: a broadcast restarts the thread that receives it, so there
    /// is only ever one of these. A guard would be worse than useless — a
    /// restarted wave would find the clock of the dead one still up and return
    /// without resetting it, leaving the board tinted for good. Taking the clock
    /// unconditionally is what makes a restart mean "start this group now".
    proc wave() {
        flash_step = 0;
        repeat_until flash_step > SPAN + 8 * STAGGER {
            redraw();
            control::wait(BEAT);
            flash_step += 1;
        }
        flash_step = -1;
        redraw();
    }

    /// Set the group off: every cell of unit `uid`, with a start delay that
    /// walks the unit, so the tint crosses it rather than blinking as a block.
    proc setup_unit(uid: num) warp {
        flash_cells.clear();
        flash_order.clear();
        for k in 1..=9 {
            let i = units[(uid - 1) * 9 + k];
            flash_cells.push(i);
            if uid <= 9 {
                flash_order.push(col_of(i));
            } else {
                if uid <= 18 {
                    flash_order.push(row_of(i));
                } else {
                    flash_order.push((row_of(i) % 3) * 3 + col_of(i) % 3);
                }
            }
        }
    }

    /// The whole board, sweeping down it a row at a time.
    proc setup_board() warp {
        flash_cells.clear();
        flash_order.clear();
        for i in 1..=81 {
            flash_cells.push(i);
            flash_order.push(row_of(i));
        }
    }

    /// Whether every cell of unit `uid` holds a value.
    proc unit_done(uid: num) -> bool warp {
        for k in 1..=9 {
            if cells[units[(uid - 1) * 9 + k]] == 0 {
                return false;
            }
        }
        return true;
    }

    /// Queue a wave for every unit the cell just filled, and for the board if
    /// that cell finished it.
    ///
    /// They go on a list rather than each starting its own animation, because a
    /// placement can finish two things at once — the cell that completes a row
    /// and its box is the usual case — and a broadcast would restart the thread
    /// part-way through the first. One list, drained in order, plays them one
    /// after another: the row, then the column, then the box, and the board last
    /// so its wave brings the win card in behind it. `BOARD` is the entry that
    /// means the whole board; the units are numbered 1 to 27.
    ///
    /// Each unit is marked as it is queued, so a cell that is somehow written
    /// twice does not set the same wave off again.
    proc queue_waves(cell: num) warp {
        let uid = row_of(cell) + 1;
        if unit_done(uid) && marked[uid] == 0 {
            marked[uid] = 1;
            queue.push(uid);
        }
        uid = col_of(cell) + 10;
        if unit_done(uid) && marked[uid] == 0 {
            marked[uid] = 1;
            queue.push(uid);
        }
        uid = boxes[cell] + 19;
        if unit_done(uid) && marked[uid] == 0 {
            marked[uid] = 1;
            queue.push(uid);
        }
        if solved() {
            queue.push(BOARD);
        }
    }

    // ---------------------------------------------------------------------
    // The game
    // ---------------------------------------------------------------------

    /// The menu, which is what the project opens on and what a finished run
    /// comes back to. Nothing is drawn on the pen layer but the HUD's text.
    proc menu() warp {
        state = 0;
        sel = 1;
        redraw();
    }

    /// Move the menu's marker, stopping at the ends rather than wrapping.
    proc move_sel(step: num) warp {
        if state != 0 {
            return;
        }
        let next = sel + step;
        if next >= 1 && next <= 3 {
            sel = next;
            sound::play(Sound::MOVE);
            redraw();
        }
    }

    /// Deal a puzzle at `level` and start playing it.
    ///
    /// The state leaves the menu before the work starts, so a second key press
    /// during a deal cannot begin a second one: two passes over the same lists
    /// would interleave, and the generator's scratch lists are shared. It also
    /// takes the board off the screen, which is what makes the wait look like
    /// something happening rather than a frozen puzzle.
    proc start(level: num) {
        if state != 0 {
            return;
        }
        state = 4;
        redraw();
        build_solution();
        dig(targets[level]);

        cells.clear();
        locked.clear();
        for i in 1..=81 {
            cells.push(puzzle[i]);
            if puzzle[i] != 0 {
                locked.push(1);
            } else {
                locked.push(0);
            }
        }

        // The first empty cell is the one the cursor starts on. Scanning
        // backwards leaves the lowest number behind, because there is no way to
        // leave a loop early.
        cursor = 1;
        let i = 81;
        repeat_until i < 1 {
            if cells[i] == 0 {
                cursor = i;
            }
            i -= 1;
        }

        mistakes = 0;
        tries = TRIES;
        state = 1;
        flash_step = -1;
        flash_cells.clear();
        flash_order.clear();
        queue.clear();
        marked.clear();
        for uid in 1..=27 {
            marked.push(0);
        }
        sensing::reset_timer();
        redraw();
    }

    /// Whether every cell is filled. Only a correct entry is ever written, so a
    /// full board is a solved board.
    proc solved() -> bool {
        for i in 1..=81 {
            if cells[i] == 0 {
                return false;
            }
        }
        return true;
    }

    proc win() warp {
        state = 2;
        seconds = floor(sensing::timer());
        redraw();
    }

    proc lose() warp {
        state = 3;
        sound::play(Sound::LOSE);
        redraw();
    }

    /// Put a digit in the current cell.
    ///
    /// A wrong digit is refused rather than written, so the board never holds a
    /// value the puzzle did not have and a full board is always the answer. It
    /// costs one of the three tries instead. There is nothing to rub out: a cell
    /// only ever takes its own answer, so a key for clearing one would have
    /// nothing to do.
    ///
    /// Nothing slow happens here. The waves a good entry may have earned are
    /// queued and one broadcast hands them to their own thread, because a key hat
    /// that is still running swallows the next press of that key — so the win
    /// card is the wave thread's job, and this returns before the board has
    /// finished celebrating.
    proc place(d: num) warp {
        if state != 1 {
            return;
        }
        if locked[cursor] == 1 {
            return;
        }
        if solution[cursor] == d {
            let cell = cursor;
            cells[cell] = d;
            queue_waves(cell);
            sound::play(Sound::GOOD);
            if queue.len() == 0 {
                redraw();
            } else {
                events::broadcast("wave");
            }
        } else {
            mistakes += 1;
            tries -= 1;
            sound::play(Sound::BAD);
            if mistakes >= TRIES {
                lose();
            } else {
                redraw();
            }
        }
    }

    proc move_cursor(dr: num, dc: num) warp {
        if state != 1 {
            return;
        }
        let r = row_of(cursor) + dr;
        let c = col_of(cursor) + dc;
        if r >= 0 && r < 9 && c >= 0 && c < 9 {
            cursor = r * 9 + c + 1;
            redraw();
        }
    }

    // ---------------------------------------------------------------------
    // Drawing
    // ---------------------------------------------------------------------

    proc given_face(d: num) warp {
        match d {
            1 => { looks::switch_costume_to(Costume::GIVEN_1); },
            2 => { looks::switch_costume_to(Costume::GIVEN_2); },
            3 => { looks::switch_costume_to(Costume::GIVEN_3); },
            4 => { looks::switch_costume_to(Costume::GIVEN_4); },
            5 => { looks::switch_costume_to(Costume::GIVEN_5); },
            6 => { looks::switch_costume_to(Costume::GIVEN_6); },
            7 => { looks::switch_costume_to(Costume::GIVEN_7); },
            8 => { looks::switch_costume_to(Costume::GIVEN_8); },
            _ => { looks::switch_costume_to(Costume::GIVEN_9); }
        }
    }

    proc user_face(d: num) warp {
        match d {
            1 => { looks::switch_costume_to(Costume::USER_1); },
            2 => { looks::switch_costume_to(Costume::USER_2); },
            3 => { looks::switch_costume_to(Costume::USER_3); },
            4 => { looks::switch_costume_to(Costume::USER_4); },
            5 => { looks::switch_costume_to(Costume::USER_5); },
            6 => { looks::switch_costume_to(Costume::USER_6); },
            7 => { looks::switch_costume_to(Costume::USER_7); },
            8 => { looks::switch_costume_to(Costume::USER_8); },
            _ => { looks::switch_costume_to(Costume::USER_9); }
        }
    }

    /// The grid itself, drawn with the pen. Every third line is the frame of a
    /// box, so it is the thick one.
    proc draw_grid() warp {
        pen::set_pen_color_to_color("#333333");
        for k in 0..=9 {
            if k % 3 == 0 {
                pen::set_pen_size_to(3);
            } else {
                pen::set_pen_size_to(1);
            }
            let x = LEFT + k * CELL;
            motion::go_to_xy(x, TOP);
            pen::pen_down();
            motion::go_to_xy(x, TOP - 9 * CELL);
            pen::pen_up();
            let y = TOP - k * CELL;
            motion::go_to_xy(LEFT, y);
            pen::pen_down();
            motion::go_to_xy(LEFT + 9 * CELL, y);
            pen::pen_up();
        }
    }

    /// The whole frame.
    ///
    /// The board is drawn only while a puzzle is being played. At the menu, while
    /// one is being generated, and on the two cards a run ends on, the pen layer
    /// is cleared and left empty for the HUD to write on.
    ///
    /// The layers go down in order: the grid, the tint under every cell that
    /// holds the same digit as the cell the cursor is on, the wave's tint, the
    /// cursor's own outline, and then the digits. The wave goes under the digits
    /// so a finished line reads as a blue background rather than a blue digit,
    /// and the ghost effect is put back to none at the top because a stamp
    /// carries the sprite's effects into the layer — a wave left at full ghost
    /// would make every later stamp invisible.
    proc redraw() warp {
        pen::clear();
        looks::set_effect_to(Effect::Ghost, 0);
        if state != 1 {
            broadcast_hud();
            return;
        }

        draw_grid();

        let focus = cells[cursor];
        if focus != 0 {
            for i in 1..=81 {
                if cells[i] == focus {
                    motion::go_to_xy(cell_x(col_of(i)), cell_y(row_of(i)));
                    looks::switch_costume_to(Costume::MATCH);
                    pen::stamp();
                }
            }
        }

        if flash_step >= 0 {
            for k in 1..=flash_cells.len() {
                let local = flash_step - flash_order[k];
                if local > 0 && local < SPAN {
                    let rise = operators::mathop(MathOp::Sin, 180 * local / SPAN);
                    motion::go_to_xy(cell_x(col_of(flash_cells[k])), cell_y(row_of(flash_cells[k])));
                    looks::switch_costume_to(Costume::FLASH);
                    looks::set_effect_to(Effect::Ghost, 100 - 72 * rise);
                    pen::stamp();
                }
            }
            looks::set_effect_to(Effect::Ghost, 0);
        }

        motion::go_to_xy(cell_x(col_of(cursor)), cell_y(row_of(cursor)));
        looks::switch_costume_to(Costume::CURSOR);
        pen::stamp();

        for i in 1..=81 {
            let value = cells[i];
            if value != 0 {
                motion::go_to_xy(cell_x(col_of(i)), cell_y(row_of(i)));
                if locked[i] == 1 {
                    given_face(value);
                } else {
                    user_face(value);
                }
                pen::stamp();
            }
        }

        broadcast_hud();
    }

    /// Park on a transparent pixel in the corner and ask the HUD to paint. Both
    /// sprites park on the same pixel: nothing of either is ever visible.
    proc broadcast_hud() warp {
        motion::go_to_xy(-235, 175);
        looks::switch_costume_to(Costume::DOT);
        events::broadcast("hud");
    }

    // ---------------------------------------------------------------------
    // Input
    // ---------------------------------------------------------------------

    on flag_clicked {
        build_tables();
        // The menu holds no puzzle at all: nothing is drawn for one and nothing
        // is left in memory for one until a difficulty is chosen.
        solution.clear();
        puzzle.clear();
        cells.clear();
        locked.clear();
        for i in 1..=81 {
            cells.push(0);
            locked.push(0);
        }
        menu();
    }

    /// Up and down do one of two jobs, and the state decides which: they walk
    /// the menu's marker when nothing is being played, and move the cursor when
    /// something is.
    on key_pressed(Key::UpArrow) {
        if state == 0 {
            move_sel(-1);
        } else {
            move_cursor(-1, 0);
        }
    }

    on key_pressed(Key::DownArrow) {
        if state == 0 {
            move_sel(1);
        } else {
            move_cursor(1, 0);
        }
    }

    on key_pressed(Key::LeftArrow) {
        move_cursor(0, -1);
    }

    on key_pressed(Key::RightArrow) {
        move_cursor(0, 1);
    }

    /// 1 to 9 fill the current cell. The menu is the arrows and Enter, so a
    /// digit does nothing until a puzzle is on the board.
    on key_pressed(Key::Digit1) {
        place(1);
    }

    on key_pressed(Key::Digit2) {
        place(2);
    }

    on key_pressed(Key::Digit3) {
        place(3);
    }

    on key_pressed(Key::Digit4) {
        place(4);
    }

    on key_pressed(Key::Digit5) {
        place(5);
    }

    on key_pressed(Key::Digit6) {
        place(6);
    }

    on key_pressed(Key::Digit7) {
        place(7);
    }

    on key_pressed(Key::Digit8) {
        place(8);
    }

    on key_pressed(Key::Digit9) {
        place(9);
    }

    /// Enter starts the difficulty the menu is on, and returns to the menu from
    /// either card.
    on key_pressed(Key::Enter) {
        if state == 0 {
            start(sel);
        } else {
            if state == 2 || state == 3 {
                menu();
            }
        }
    }

    /// A finished line, a finished box or a finished board asks for its wave, in
    /// that order, and the win card comes after the last of them. Running them
    /// here rather than in the key handler is the point: the animation waits, and
    /// a key hat that is still running swallows the next press of that key.
    ///
    /// The thread is restarted if a second wave is asked for while this one is
    /// still going, and that is safe: an entry is taken off the list before it is
    /// played, so the restarted thread picks up the ones that are left.
    on broadcast_received("wave") {
        repeat_until queue.len() == 0 {
            let uid = queue[1];
            queue.remove(1);
            if uid == BOARD {
                setup_board();
                sound::play(Sound::WIN);
                wave();
                win();
            } else {
                setup_unit(uid);
                sound::play(Sound::UNIT);
                wave();
            }
        }
    }
}
