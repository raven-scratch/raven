// The demo: type, and watch it appear.
//
// Every key that can be typed is a `when key pressed` hat, which is the only way
// Scratch reports a key: `sensing_keypressed` needs one of the fixed names in its
// menu, so a key cannot be held in a list and polled. The arrows are borrowed —
// left erases, right walks the alignment, down walks the colour theme — and up
// is shift, held down rather than toggled, because a `forever` script can read
// it every frame.
//
// Scratch's key menu has no punctuation on it at all, so the buffer opens with a
// line that uses the rest of the font: every character the table has is
// typeable, and everything here is typeable by hand.

use lib::text;

sprite "Typewriter" {
    // font:costumes
    costume "g32" = "assets/font/32.svg";
    costume "g101" = "assets/font/101.svg";
    costume "g116" = "assets/font/116.svg";
    costume "g97" = "assets/font/97.svg";
    costume "g111" = "assets/font/111.svg";
