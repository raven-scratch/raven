    costume "g64" = "assets/font/64.svg";
    costume "g92" = "assets/font/92.svg";
    costume "g94" = "assets/font/94.svg";
    costume "g95" = "assets/font/95.svg";
    costume "g96" = "assets/font/96.svg";
    costume "g124" = "assets/font/124.svg";
    costume "g126" = "assets/font/126.svg";
    costume "g63" = "assets/font/63.svg";
    // font:end

    on flag_clicked {
        looks::hide();
        reset();
        bar = "LEFT CLEAR   UP SHIFT   RIGHT ALIGN   DOWN COLOR";
        write(
            "The raven text engine draws a proportional 5x8 font with the pen, one stamp per glyph: whole sentences wrap themselves to the column, and each character keeps its own colour. "
        );
        write(
            "0123456789 !\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"
        );
        refresh();
        forever {
            shift = 0;
            if sensing::key_pressed(Key::UpArrow) {
                shift = 1;
            }
        }
    }

    on key_pressed(Key::LeftArrow) { backspace(); }
    on key_pressed(Key::RightArrow) { cycle_align(); }
    on key_pressed(Key::DownArrow) { cycle_theme(); }

    on key_pressed(Key::Space) { type_char(" "); }
    on key_pressed(Key::Digit0) { type_char("0"); }
    on key_pressed(Key::Digit1) { type_char("1"); }
    on key_pressed(Key::Digit2) { type_char("2"); }
    on key_pressed(Key::Digit3) { type_char("3"); }
    on key_pressed(Key::Digit4) { type_char("4"); }
    on key_pressed(Key::Digit5) { type_char("5"); }
    on key_pressed(Key::Digit6) { type_char("6"); }
    on key_pressed(Key::Digit7) { type_char("7"); }
    on key_pressed(Key::Digit8) { type_char("8"); }
    on key_pressed(Key::Digit9) { type_char("9"); }

    on key_pressed(Key::A) { type_char("a"); }
    on key_pressed(Key::B) { type_char("b"); }
    on key_pressed(Key::C) { type_char("c"); }
    on key_pressed(Key::D) { type_char("d"); }
    on key_pressed(Key::E) { type_char("e"); }
    on key_pressed(Key::F) { type_char("f"); }
    on key_pressed(Key::G) { type_char("g"); }
    on key_pressed(Key::H) { type_char("h"); }
    on key_pressed(Key::I) { type_char("i"); }
    on key_pressed(Key::J) { type_char("j"); }
    on key_pressed(Key::K) { type_char("k"); }
    on key_pressed(Key::L) { type_char("l"); }
    on key_pressed(Key::M) { type_char("m"); }
    on key_pressed(Key::N) { type_char("n"); }
    on key_pressed(Key::O) { type_char("o"); }
    on key_pressed(Key::P) { type_char("p"); }
    on key_pressed(Key::Q) { type_char("q"); }
    on key_pressed(Key::R) { type_char("r"); }
    on key_pressed(Key::S) { type_char("s"); }
    on key_pressed(Key::T) { type_char("t"); }
    on key_pressed(Key::U) { type_char("u"); }
    on key_pressed(Key::V) { type_char("v"); }
    on key_pressed(Key::W) { type_char("w"); }
    on key_pressed(Key::X) { type_char("x"); }
    on key_pressed(Key::Y) { type_char("y"); }
    on key_pressed(Key::Z) { type_char("z"); }
}
