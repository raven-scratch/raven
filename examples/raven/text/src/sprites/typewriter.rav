    costume "g106" = "assets/font/106.svg";
    costume "g113" = "assets/font/113.svg";
    costume "g120" = "assets/font/120.svg";
    costume "g122" = "assets/font/122.svg";
    costume "g65" = "assets/font/65.svg";
    costume "g66" = "assets/font/66.svg";
    costume "g67" = "assets/font/67.svg";
    costume "g68" = "assets/font/68.svg";
    costume "g69" = "assets/font/69.svg";
    costume "g70" = "assets/font/70.svg";
    costume "g71" = "assets/font/71.svg";
    costume "g72" = "assets/font/72.svg";
    costume "g73" = "assets/font/73.svg";
    costume "g74" = "assets/font/74.svg";
    costume "g75" = "assets/font/75.svg";
    costume "g76" = "assets/font/76.svg";
    costume "g77" = "assets/font/77.svg";
    costume "g78" = "assets/font/78.svg";
    costume "g79" = "assets/font/79.svg";
    costume "g80" = "assets/font/80.svg";
    costume "g81" = "assets/font/81.svg";
    costume "g82" = "assets/font/82.svg";
    costume "g83" = "assets/font/83.svg";
    costume "g84" = "assets/font/84.svg";
    costume "g85" = "assets/font/85.svg";
    costume "g86" = "assets/font/86.svg";
    costume "g87" = "assets/font/87.svg";
    costume "g88" = "assets/font/88.svg";
    costume "g89" = "assets/font/89.svg";
    costume "g90" = "assets/font/90.svg";
    costume "g48" = "assets/font/48.svg";
    costume "g49" = "assets/font/49.svg";
    costume "g50" = "assets/font/50.svg";
    costume "g51" = "assets/font/51.svg";
