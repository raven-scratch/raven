// The rules of chess and the maia network, in raven.
//
// The board is a 10 wide mailbox of 120 cells: rows 2 to 9 hold the eight ranks
// and everything else is 99. One step of 10 is one rank up, so a slider walks a
// direction until it meets a cell that is not empty, and a knight's two rank
// jump lands on an edge rather than off the end of the list. The cell of a real
// square is `(rank + 2) * 10 + file + 1`.
//
// Every piece of state is a number or a Scratch list on the stage: the board
// the pen draws from is the board the rules read, and the move list the network
// is scored against is the move list a click is checked against. Nothing here
// names a Scratch variable, so nothing here shows up in the editor's variable
// list and no monitor is declared.
//
// The network is the maia-1100 lc0 network. Its weights are one list `w` and
// one list `b`, generated by `tools/maia.py --export`, and a layer is a window
// into them: `wbase`, `bbase` and `block_w` below say where. `maia.py` prints
// the offsets it computed, so the two can be compared.

// ---------------------------------------------------------------------------
// State
// ---------------------------------------------------------------------------

use net;

/// 0 empty, 1..6 white pawn..king, 7..12 black, 99 the edge of the board.
pub var board: list<num> = [];
pub var side: num = 0;
/// 1 white kingside, 2 white queenside, 4 black kingside, 8 black queenside.
pub var castle: num = 0;
/// The cell a pawn steps onto when it takes en passant, or 0 for none.
pub var ep: num = 0;
pub var rule50: num = 0;

/// The last eight positions, 69 cells each: 64 board, then side, castling, en
/// passant, the fifty move clock, and how often the position has repeated.
/// `histn` is how many are filled and the oldest is where the game began.
pub var hist: list<num> = [];
pub var histn: num = 0;

/// Every move that follows the piece rules, then the ones that leave the king
/// safe. A move is a from cell, a to cell and a promotion kind, 0 for none.
pub var mvf: list<num> = [];
pub var mvt: list<num> = [];
pub var mvp: list<num> = [];
pub var nmv: num = 0;
pub var okf: list<num> = [];
pub var okt: list<num> = [];
pub var okp: list<num> = [];
pub var nok: num = 0;

/// What `un_move` puts back: from, to, the piece captured, the piece that
/// moved, the en passant cell, castling rights and the fifty move clock.
pub var undo: list<num> = [];
/// Somewhere for `legal` to keep the caller's `undo` while it tries moves: a
/// legality test moves the board and puts it back, and it would otherwise leave
/// its own last move's record where the caller expects its own.
pub var undok: list<num> = [];

/// The network. `b` is the biases of the bot being played and `w`, which
/// `src/net.rav` writes out at its full length, is its weights: two lists
/// concatenated in layer order, which is the layout `wbase`, `bbase` and
/// `block_w` describe. `load_bot` fills both from `wq`.
///
/// `w` is not built by appending, because Scratch refuses to `add to list` past
/// two hundred thousand items and this list is four times that. It is written
/// out as a literal and overwritten in place instead.
pub var b: list<num> = [];
/// Which bot `w` and `b` hold, or -1 for none yet.
pub var bot: num = -1;
/// The gain of each output channel of the layer being unpacked, which is one
/// batch norm folded in.
pub var gam: list<num> = [];

/// `planes` is the 112 plane input with its one cell border, and
/// `bufl` is the value running through the tower. `bufl2` takes each layer's
/// output and keeps the policy head; `bufv` is the value head's convolution.
pub var planes: list<num> = [];
pub var bufl: list<num> = [];
pub var bufl2: list<num> = [];
/// The shortcut. A block adds its result to the value it was given, and that
/// value is gone from `bufl` by the time the second convolution is in `bufl2`,
/// so it is kept here for the length of the block.
pub var bufx: list<num> = [];
pub var bufv: list<num> = [];
pub var pool: list<num> = [];
pub var fc1: list<num> = [];
pub var fc2: list<num> = [];
pub var hid: list<num> = [];
pub var wdl: list<num> = [];

/// The move the bot chose and the score the policy head gave it.
pub var bestf: num = 0;
pub var bestt: num = 0;
pub var bestp: num = 0;
pub var bestscore: num = 0;

/// One row per remaining ply, for the perft walk: the moves it still has to
/// try, which one it is on, and how many leaves it has counted.
pub var pf_from: list<num> = [];
pub var pf_to: list<num> = [];
pub var pf_promo: list<num> = [];
pub var pf_n: list<num> = [];
pub var pf_i: list<num> = [];
pub var pf_total: list<num> = [];
/// Each ply keeps the undo record of the move that led into it. The board can
/// only hold one at a time, and the walk needs the one belonging to the ply it
/// is about to step back into, not the one the deepest move happened to leave.
pub var pf_undo: list<num> = [];

pub const WALL: num = 99;
pub const SLOT: num = 69;
pub const SLOTS: num = 8;
pub const MAXMOVE: num = 256;

// ---------------------------------------------------------------------------
// Squares
// ---------------------------------------------------------------------------

pub fn cell(rank: num, file: num) -> num {
    (rank + 2) * 10 + file + 1
}

/// The Scratch item of a cell. A Scratch list counts from one and the cell
/// numbering counts from zero, so every read and write of the board goes
/// through this; a difference of two cells is the same either way.
pub fn atc(c: num) -> num {
    c + 1
}

pub fn rank_of(m: num) -> num {
    floor(m / 10) - 2
}

pub fn file_of(m: num) -> num {
    m % 10 - 1
}

/// The 0..63 square of a mailbox cell, a1 = 0 and h8 = 63.
pub fn sq64(m: num) -> num {
    (floor(m / 10) - 2) * 8 + m % 10 - 1
}

/// What was on rank 1 is on rank 8.
pub fn flip64(s: num) -> num {
    (7 - floor(s / 8)) * 8 + s % 8
}

pub fn hasbit(value: num, bit: num) -> bool {
    floor(value / bit) % 2 == 1
}

pub fn mine(piece: num, who: num) -> bool {
    piece != 0 && piece != WALL && (piece <= 6) == (who == 0)
}

pub fn foe(piece: num, who: num) -> bool {
    piece != 0 && piece != WALL && !mine(piece, who)
}

// ---------------------------------------------------------------------------
// The board
// ---------------------------------------------------------------------------

/// Give every list its size once and never grow it again: assigning past the
/// end of a Scratch list costs five extra blocks, and every one of these has a
/// size that is known before the game starts.
pub proc setup() warp {
    board.clear();
    for i in 0..120 { board.push(0); }
    hist.clear();
    for i in 0..(SLOTS * SLOT) { hist.push(0); }
    planes.clear();
    for i in 0..(112 * 100) { planes.push(0); }
    bufl.clear();
    for i in 0..(64 * 100) { bufl.push(0); }
    bufl2.clear();
    for i in 0..(80 * 100) { bufl2.push(0); }
    bufx.clear();
    for i in 0..(64 * 100) { bufx.push(0); }
    bufv.clear();
    for i in 0..(32 * 64) { bufv.push(0); }
    pool.clear();
    for i in 0..64 { pool.push(0); }
    fc1.clear();
    for i in 0..8 { fc1.push(0); }
    fc2.clear();
    for i in 0..128 { fc2.push(0); }
    hid.clear();
    for i in 0..128 { hid.push(0); }
    wdl.clear();
    for i in 0..3 { wdl.push(0); }
    b.clear();
    gam.clear();
    for i in 0..128 { gam.push(0); }
    bot = -1;
    mvf.clear();
    for i in 0..MAXMOVE { mvf.push(0); }
    mvt.clear();
    for i in 0..MAXMOVE { mvt.push(0); }
    mvp.clear();
    for i in 0..MAXMOVE { mvp.push(0); }
    okf.clear();
    for i in 0..MAXMOVE { okf.push(0); }
    okt.clear();
    for i in 0..MAXMOVE { okt.push(0); }
    okp.clear();
    for i in 0..MAXMOVE { okp.push(0); }
    undo.clear();
    for i in 0..7 { undo.push(0); }
    undok.clear();
    for i in 0..7 { undok.push(0); }
    pf_from.clear();
    for i in 0..(SLOTS * MAXMOVE) { pf_from.push(0); }
    pf_to.clear();
    for i in 0..(SLOTS * MAXMOVE) { pf_to.push(0); }
    pf_promo.clear();
    for i in 0..(SLOTS * MAXMOVE) { pf_promo.push(0); }
    pf_n.clear();
    for i in 0..SLOTS { pf_n.push(0); }
    pf_i.clear();
    for i in 0..SLOTS { pf_i.push(0); }
    pf_total.clear();
    for i in 0..SLOTS { pf_total.push(0); }
    pf_undo.clear();
    for i in 0..(SLOTS * 7) { pf_undo.push(0); }
}

/// The 120 cell mailbox with only its edge filled in.
pub proc blank() warp {
    for m in 0..120 {
        let row = floor(m / 10);
        let col = m % 10;
        if row < 2 || row > 9 || col == 0 || col == 9 {
            board[atc(m)] = WALL;
        } else {
            board[atc(m)] = 0;
        }
    }
}

pub proc put(piece: num, rank: num, file: num) warp {
    board[atc(cell(rank, file))] = piece;
}

/// Copy the position into history slot `k`, with the repetition count it was
/// already known to have.
pub proc save(k: num, reps: num) warp {
    let base = k * SLOT;
    for r in 0..8 {
        for f in 0..8 {
            hist[base + r * 8 + f + 1] = board[atc(cell(r, f))];
        }
    }
    hist[base + 65] = side;
    hist[base + 66] = castle;
    hist[base + 67] = ep;
    hist[base + 68] = rule50;
    hist[base + 69] = reps;
}

pub proc start_board() warp {
    blank();
    for f in 0..8 {
        put(1, 1, f);
        put(7, 6, f);
    }
    put(4, 0, 0);
    put(2, 0, 1);
    put(3, 0, 2);
    put(5, 0, 3);
    put(6, 0, 4);
    put(3, 0, 5);
    put(2, 0, 6);
    put(4, 0, 7);
    put(10, 7, 0);
    put(8, 7, 1);
    put(9, 7, 2);
    put(11, 7, 3);
    put(12, 7, 4);
    put(9, 7, 5);
    put(8, 7, 6);
    put(10, 7, 7);
    side = 0;
    castle = 15;
    ep = 0;
    rule50 = 0;
    histn = 1;
    save(0, 0);
}

/// Whether the position in slot `k` has `value` in the given field.
pub proc slot_is(k: num, field: num, value: num) -> bool warp {
    return hist[k * SLOT + field + 64] == value;
}

pub proc slot_board_is(k: num) -> bool warp {
    let base = k * SLOT;
    for r in 0..8 {
        for f in 0..8 {
            if hist[base + r * 8 + f + 1] != board[atc(cell(r, f))] { return false; }
        }
    }
    return true;
}

/// lc0's PositionHistory::ComputeLastMoveRepetitions: how often the position
/// now on the board has occurred before, two plies at a time back to the last
/// capture or pawn move.
pub proc repetitions() -> num warp {
    if rule50 < 4 { return 0; }
    let i = histn - 4;
    repeat_until i < 0 {
        if slot_board_is(i) && slot_is(i, 1, side) && slot_is(i, 2, castle) && slot_is(i, 3, ep) {
            return 1 + hist[i * SLOT + SLOT];
        }
        if hist[i * SLOT + 68] < 2 { return 0; }
        i -= 2;
    }
    return 0;
}

/// Remember the position the board is on now as the newest one.
pub proc commit() warp {
    let reps = repetitions();
    if histn < SLOTS {
        save(histn, reps);
        histn += 1;
    } else {
        for k in 0..(SLOTS - 1) {
            for i in 0..SLOT {
                hist[k * SLOT + i + 1] = hist[(k + 1) * SLOT + i + 1];
            }
        }
        save(SLOTS - 1, reps);
    }
}

// ---------------------------------------------------------------------------
// Attacks
// ---------------------------------------------------------------------------

/// Walk from `m` in one direction; true when the first piece met is either of
/// the two kinds given.
pub proc ray(m: num, step: num, kind: num, queen: num) -> bool warp {
    let q = m + step;
    repeat_until board[atc(q)] != 0 {
        q += step;
    }
    if board[atc(q)] == kind { return true; }
    return board[atc(q)] == queen;
}

/// Whether side `who` attacks the cell `m`. The piece standing on `m` does not
/// matter: this is the question a king move and a legality test both ask.
pub proc atk(m: num, who: num) -> bool warp {
    let pawn = 1;
    let knight = 2;
    let bishop = 3;
    let rook = 4;
    let queen = 5;
    let king = 6;
    if who == 1 {
        pawn = 7;
        knight = 8;
        bishop = 9;
        rook = 10;
        queen = 11;
        king = 12;
    }
    if who == 0 {
        if board[atc(m - 9)] == pawn || board[atc(m - 11)] == pawn { return true; }
    } else {
        if board[atc(m + 9)] == pawn || board[atc(m + 11)] == pawn { return true; }
    }
    if board[atc(m - 21)] == knight || board[atc(m - 19)] == knight { return true; }
    if board[atc(m - 12)] == knight || board[atc(m - 8)] == knight { return true; }
    if board[atc(m + 8)] == knight || board[atc(m + 12)] == knight { return true; }
    if board[atc(m + 19)] == knight || board[atc(m + 21)] == knight { return true; }
    if board[atc(m - 11)] == king || board[atc(m - 10)] == king { return true; }
    if board[atc(m - 9)] == king || board[atc(m - 1)] == king { return true; }
    if board[atc(m + 1)] == king || board[atc(m + 9)] == king { return true; }
    if board[atc(m + 10)] == king || board[atc(m + 11)] == king { return true; }
    if ray(m, 10, rook, queen) || ray(m, -10, rook, queen) { return true; }
    if ray(m, 1, rook, queen) || ray(m, -1, rook, queen) { return true; }
    if ray(m, 11, bishop, queen) || ray(m, 9, bishop, queen) { return true; }
    if ray(m, -9, bishop, queen) || ray(m, -11, bishop, queen) { return true; }
    return false;
}

pub proc king_of(who: num) -> num warp {
    let target = 6;
    if who == 1 { target = 12; }
    for r in 0..8 {
        for f in 0..8 {
            if board[atc(cell(r, f))] == target { return cell(r, f); }
        }
    }
    return 0;
}

pub proc in_check(who: num) -> bool warp {
    let k = king_of(who);
    if k == 0 { return false; }
    return atk(k, 1 - who);
}

// ---------------------------------------------------------------------------
// Generating moves
// ---------------------------------------------------------------------------

pub proc add(f: num, t: num, p: num) warp {
    nmv += 1;
    mvf[nmv] = f;
    mvt[nmv] = t;
    mvp[nmv] = p;
}

pub proc slide(m: num, step: num, who: num) warp {
    let q = m + step;
    repeat_until board[atc(q)] != 0 {
        add(m, q, 0);
        q += step;
    }
    if board[atc(q)] != WALL && !mine(board[atc(q)], who) { add(m, q, 0); }
}

pub proc leaps(m: num, who: num) warp {
    if board[atc(m - 21)] != WALL && !mine(board[atc(m - 21)], who) { add(m, m - 21, 0); }
    if board[atc(m - 19)] != WALL && !mine(board[atc(m - 19)], who) { add(m, m - 19, 0); }
    if board[atc(m - 12)] != WALL && !mine(board[atc(m - 12)], who) { add(m, m - 12, 0); }
    if board[atc(m - 8)] != WALL && !mine(board[atc(m - 8)], who) { add(m, m - 8, 0); }
    if board[atc(m + 8)] != WALL && !mine(board[atc(m + 8)], who) { add(m, m + 8, 0); }
    if board[atc(m + 12)] != WALL && !mine(board[atc(m + 12)], who) { add(m, m + 12, 0); }
    if board[atc(m + 19)] != WALL && !mine(board[atc(m + 19)], who) { add(m, m + 19, 0); }
    if board[atc(m + 21)] != WALL && !mine(board[atc(m + 21)], who) { add(m, m + 21, 0); }
}

/// Castling is a king move two files across; the rook is left where it is and
/// `do_move` puts it down. The king may not start in check, cross an attacked
/// square, or land on one.
pub proc castle_moves(rank: num, m: num) warp {
    let kmask = 1;
    let qmask = 2;
    if side == 1 {
        kmask = 4;
        qmask = 8;
    }
    if hasbit(castle, kmask) && board[atc(cell(rank, 5))] == 0 && board[atc(cell(rank, 6))] == 0 {
        if !atk(cell(rank, 4), 1 - side) && !atk(cell(rank, 5), 1 - side) && !atk(cell(rank, 6), 1 - side) {
            add(m, cell(rank, 6), 0);
        }
    }
    if hasbit(castle, qmask) && board[atc(cell(rank, 1))] == 0 {
        if board[atc(cell(rank, 2))] == 0 && board[atc(cell(rank, 3))] == 0 {
            if !atk(cell(rank, 4), 1 - side) && !atk(cell(rank, 3), 1 - side) && !atk(cell(rank, 2), 1 - side) {
                add(m, cell(rank, 2), 0);
            }
        }
    }
}

/// A capturing pawn that has reached the last rank promotes, four ways.
pub proc promotion(m: num, t: num) warp {
    if foe(board[atc(t)], side) {
        add(m, t, 5);
        add(m, t, 4);
        add(m, t, 3);
        add(m, t, 2);
    }
}

pub proc king_steps(m: num, who: num) warp {
    if board[atc(m - 11)] != WALL && !mine(board[atc(m - 11)], who) { add(m, m - 11, 0); }
    if board[atc(m - 10)] != WALL && !mine(board[atc(m - 10)], who) { add(m, m - 10, 0); }
    if board[atc(m - 9)] != WALL && !mine(board[atc(m - 9)], who) { add(m, m - 9, 0); }
    if board[atc(m - 1)] != WALL && !mine(board[atc(m - 1)], who) { add(m, m - 1, 0); }
    if board[atc(m + 1)] != WALL && !mine(board[atc(m + 1)], who) { add(m, m + 1, 0); }
    if board[atc(m + 9)] != WALL && !mine(board[atc(m + 9)], who) { add(m, m + 9, 0); }
    if board[atc(m + 10)] != WALL && !mine(board[atc(m + 10)], who) { add(m, m + 10, 0); }
    if board[atc(m + 11)] != WALL && !mine(board[atc(m + 11)], who) { add(m, m + 11, 0); }
}

pub proc gen() warp {
    nmv = 0;
    let up = 10;
    let home = 1;
    let last = 6;
    if side == 1 {
        up = -10;
        home = 6;
        last = 1;
    }
    for r in 0..8 {
        for f in 0..8 {
            let m = cell(r, f);
            let piece = board[atc(m)];
            if mine(piece, side) {
                let kind = (piece - 1) % 6 + 1;
                if kind == 1 {
                    if board[atc(m + up)] == 0 {
                        if r == last {
                            add(m, m + up, 5);
                            add(m, m + up, 4);
                            add(m, m + up, 3);
                            add(m, m + up, 2);
                        } else {
                            add(m, m + up, 0);
                            if r == home && board[atc(m + 2 * up)] == 0 { add(m, m + 2 * up, 0); }
                        }
                    }
                    if r == last {
                        promotion(m, m + up - 1);
                        promotion(m, m + up + 1);
                    } else {
                        if foe(board[atc(m + up - 1)], side) { add(m, m + up - 1, 0); }
                        if foe(board[atc(m + up + 1)], side) { add(m, m + up + 1, 0); }
                        if ep != 0 && m + up - 1 == ep { add(m, ep, 0); }
                        if ep != 0 && m + up + 1 == ep { add(m, ep, 0); }
                    }
                }
                if kind == 2 { leaps(m, side); }
                if kind == 3 {
                    slide(m, 11, side);
                    slide(m, 9, side);
                    slide(m, -9, side);
                    slide(m, -11, side);
                }
                if kind == 4 {
                    slide(m, 10, side);
                    slide(m, -10, side);
                    slide(m, 1, side);
                    slide(m, -1, side);
                }
                if kind == 5 {
                    slide(m, 11, side);
                    slide(m, 9, side);
                    slide(m, -9, side);
                    slide(m, -11, side);
                    slide(m, 10, side);
                    slide(m, -10, side);
                    slide(m, 1, side);
                    slide(m, -1, side);
                }
                if kind == 6 {
                    king_steps(m, side);
                    castle_moves(r, m);
                }
            }
        }
    }
}

/// Lay one move on the board and leave what `un_move` needs in `undo`.
pub proc do_move(f: num, t: num, p: num) warp {
    let piece = board[atc(f)];
    let kind = (piece - 1) % 6 + 1;
    let captured = board[atc(t)];
    let right = 1;
    let other = 4;
    if side == 1 {
        right = 4;
        other = 1;
    }
    undo[1] = f;
    undo[2] = t;
    undo[3] = captured;
    undo[4] = piece;
    undo[5] = ep;
    undo[6] = castle;
    undo[7] = rule50;

    rule50 += 1;
    if kind == 1 || captured != 0 { rule50 = 0; }

    if kind == 1 && ep != 0 && t == ep && file_of(f) != file_of(t) {
        rule50 = 0;
        if side == 0 { board[atc(t - 10)] = 0; }
        if side == 1 { board[atc(t + 10)] = 0; }
    }
    if kind == 4 && rank_of(f) == 7 * side {
        if file_of(f) == 0 && hasbit(castle, 2 * right) { castle -= 2 * right; }
        if file_of(f) == 7 && hasbit(castle, 1 * right) { castle -= 1 * right; }
    }
    if kind == 6 {
        if hasbit(castle, 1 * right) { castle -= 1 * right; }
        if hasbit(castle, 2 * right) { castle -= 2 * right; }
        if file_of(t) - file_of(f) == 2 {
            let h = 0;
            if side == 1 { h = 7; }
            board[atc(cell(h, 5))] = board[atc(cell(h, 7))];
            board[atc(cell(h, 7))] = 0;
        }
        if file_of(t) - file_of(f) == -2 {
            let h = 0;
            if side == 1 { h = 7; }
            board[atc(cell(h, 3))] = board[atc(cell(h, 0))];
            board[atc(cell(h, 0))] = 0;
        }
    }
    if captured != 0 && rank_of(t) == 7 - 7 * side {        if file_of(t) == 0 && hasbit(castle, 2 * other) { castle -= 2 * other; }
        if file_of(t) == 7 && hasbit(castle, 1 * other) { castle -= 1 * other; }
    }
    if p == 0 {
        board[atc(t)] = piece;
    } else {
        board[atc(t)] = p;
        if side == 1 { board[atc(t)] = p + 6; }
    }
    board[atc(f)] = 0;
    ep = 0;
    if kind == 1 && t - f == 20 { ep = f + 10; }
    if kind == 1 && f - t == 20 { ep = f - 10; }
    side = 1 - side;
}

/// Put back the move `do_move` laid down, without touching the history.
pub proc un_move() warp {
    let f = undo[1];
    let t = undo[2];
    let piece = undo[4];
    let kind = (piece - 1) % 6 + 1;
    let mover = 1 - side;
    let h = 0;
    if mover == 1 { h = 7; }
    if kind == 6 && file_of(t) - file_of(f) == 2 {
        board[atc(cell(h, 7))] = board[atc(cell(h, 5))];
        board[atc(cell(h, 5))] = 0;
    }
    if kind == 6 && file_of(t) - file_of(f) == -2 {
        board[atc(cell(h, 0))] = board[atc(cell(h, 3))];
        board[atc(cell(h, 3))] = 0;
    }
    if kind == 1 && undo[5] != 0 && t == undo[5] && file_of(f) != file_of(t) {
        if mover == 0 { board[atc(t - 10)] = 7; }
        if mover == 1 { board[atc(t + 10)] = 1; }
    }
    board[atc(f)] = piece;
    board[atc(t)] = undo[3];
    ep = undo[5];
    castle = undo[6];
    rule50 = undo[7];
    side = 1 - side;
}

/// Fill the ok lists with the moves that leave our own king safe.
pub proc legal() warp {
    for i in 0..7 { undok[i + 1] = undo[i + 1]; }
    gen();
    nok = 0;
    let who = side;
    for i in 0..nmv {
        do_move(mvf[i + 1], mvt[i + 1], mvp[i + 1]);
        if !in_check(who) {
            nok += 1;
            okf[nok] = mvf[i + 1];
            okt[nok] = mvt[i + 1];
            okp[nok] = mvp[i + 1];
        }
        un_move();
    }
    for i in 0..7 { undo[i + 1] = undok[i + 1]; }
}

/// Whether `f` holds a legal move landing on `t`.
pub proc can_move(f: num, t: num) -> bool warp {
    for i in 0..nok {
        if okf[i + 1] == f && okt[i + 1] == t { return true; }
    }
    return false;
}

/// The only legal move ending on `t`, for the promotion prompt, or 0.
pub proc promotion_of(f: num, t: num) -> num warp {
    for i in 0..nok {
        if okf[i + 1] == f && okt[i + 1] == t && okp[i + 1] != 0 { return okp[i + 1]; }
    }
    return 0;
}

// ---------------------------------------------------------------------------
// The 112 planes
// ---------------------------------------------------------------------------

/// Set all 64 board squares of a plane and leave its border zero: the border is
/// the convolution's padding, and lc0's SetAll covers the board and nothing else.
pub proc fill(p: num, v: num) warp {
    for r in 0..8 {
        for f in 0..8 {
            planes[p * 100 + r * 10 + f + 12] = v;
        }
    }
}

/// lc0's classical encoder. Every one of the eight history boards is written in
/// the frame of the side to move: the pieces named "ours" are the side that is
/// to move now, and each board is mirrored when that side is black.
pub proc encode() warp {
    for p in 0..112 {
        for j in 0..100 { planes[p * 100 + j + 1] = 0; }
    }
    let ourk = 1;
    let ourq = 2;
    let theirk = 4;
    let theirq = 8;
    if side == 1 {
        ourk = 4;
        ourq = 8;
        theirk = 1;
        theirq = 2;
    }
    if hasbit(castle, ourq) { fill(104, 1); }
    if hasbit(castle, ourk) { fill(105, 1); }
    if hasbit(castle, theirq) { fill(106, 1); }
    if hasbit(castle, theirk) { fill(107, 1); }
    if side == 1 { fill(108, 1); }
    fill(109, rule50);
    fill(111, 1);

    for i in 0..SLOTS {
        if i < histn {
            let base = (histn - 1 - i) * SLOT;
            for r in 0..8 {
                for f in 0..8 {
                    let piece = hist[base + r * 8 + f + 1];
                    if piece != 0 {
                        let row = r;
                        if side == 1 { row = 7 - r; }
                        let plane = i * 13 + (piece - 1) % 6;
                        if !((piece <= 6) == (side == 0)) { plane += 6; }
                        planes[plane * 100 + row * 10 + f + 12] = 1;
                    }
                }
            }
            if hist[base + SLOT] >= 1 { fill(i * 13 + 12, 1); }
        }
    }
}

// ---------------------------------------------------------------------------
// The network
// ---------------------------------------------------------------------------

// Where each layer lives in `w` and `b`. tools/maia.py --export prints the same
// numbers when it writes src/net.rav.
pub proc wbase(layer: num) -> num warp {
    let at = 0;
    if layer == 1 { at = 516096; }
    if layer == 2 { at = 552960; }
    if layer == 3 { at = 599040; }
    if layer == 4 { at = 601088; }
    if layer == 5 { at = 863232; }
    return at;
}

pub proc bbase(layer: num) -> num warp {
    let at = 0;
    if layer == 1 { at = 1648; }
    if layer == 2 { at = 1712; }
    if layer == 3 { at = 1792; }
    if layer == 4 { at = 1824; }
    if layer == 5 { at = 1952; }
    return at;
}

pub fn block_w(k: num) -> num {
    64512 + k * 75264
}

pub fn block_b(k: num) -> num {
    64 + k * 264
}

/// Unpack a bot: `wq` holds all nine networks with three 16 bit weights in
/// each list item, and this puts one of them back the way the file had it,
/// folds each layer's batch norm into it, and leaves the two lists the forward
/// pass reads. A layer's weights are a fraction of a range the layer carries,
/// and its gain is its gamma over the square root of its variance.
/// Whether the clock has moved a second, and put the second in `secs` if it has.
///
/// The panel's clock line is written by the HUD, which looks at `secs` itself:
/// the board's own loop cannot say a second has passed while a bot's turn is
/// running, because a turn runs inside one frame of that loop, and a broadcast
/// from in here would put a message block in the middle of the search, which is
/// where a compiler does its work. `load_bot` and `conv3` therefore call this
/// and nothing more: the second is counted where the second is spent.
pub proc clock_tick() warp {
    let s = floor(sensing::timer() - t0);
    if s != secs { secs = s; }
}

pub proc load_bot(e: num) warp {
    b.clear();
    let wi = 0;
    for l in 0..BLAYERS {
        // Unpacking a network is seconds of work inside one frame, so the clock
        // is given its turn here as well as in the search below.
        clock_tick();
        let count = lnum[l + 1];
        let per = lper[l + 1];
        let outs = lout[l + 1];
        let kind = lk[l + 1];
        let slot = e * BSLOT + lgo[l + 1];
        let pack = e * BPACK + lp[l + 1];
        let mn = wlmin[e * BLAYERS + l + 1];
        let mx = wlmax[e * BLAYERS + l + 1];
        for c in 0..outs {
            let gain = 1;
            if kind == 0 {
                gain = botg[slot + c + 1] * (1 / sqrt(botsd[slot + c + 1] + 1e-5));
                b.push(bott[slot + c + 1] - gain * botm[slot + c + 1]);
            } else {
                b.push(bott[slot + c + 1]);
            }
            gam[c + 1] = gain;
        }
        for g in 0..ceil(count / 3) {
            let item = wq[pack + g + 1];
            let rest = floor(item / 65536);
            let q0 = item % 65536;
            let q1 = rest % 65536;
            let q2 = floor(rest / 65536);
            let i = g * 3;
            if i < count {
                wi += 1;
                w[wi] = (mn + (mx - mn) * q0 / 65535) * gam[floor(i / per) + 1];
            }
            if i + 1 < count {
                wi += 1;
                w[wi] = (mn + (mx - mn) * q1 / 65535) * gam[floor((i + 1) / per) + 1];
            }
            if i + 2 < count {
                wi += 1;
                w[wi] = (mn + (mx - mn) * q2 / 65535) * gam[floor((i + 2) / per) + 1];
            }
        }
    }
    bot = e;
}

/// One 3x3 convolution from `bufl` into `bufl2`, batch norm already folded into
/// `w` and `b` by the generator. `relu` is 0 for a block's second convolution,
/// which the squeeze-excitation unit gates afterwards.
pub proc conv3(wb: num, bb: num, inch: num, outch: num, relu: num) warp {
    for oc in 0..outch {
        // The search is most of the game's thinking and this is the innermost of
        // it, so it is where the clock is kept: see `clock_tick`.
        clock_tick();
        for r in 0..8 {
            for f in 0..8 {
                let acc = b[bb + oc + 1];
                for ic in 0..inch {
                    let wrow = wb + (oc * inch + ic) * 9;
                    // The window's top left is the padding row and column
                    // before this output, which is where the plane starts:
                    // a cell of the 8x8 is one in from the border, so the
                    // output at r, f reads from r, f of the padded plane.
                    let prow = ic * 100 + r * 10 + f + 1;
                    for ky in 0..3 {
                        for kx in 0..3 {
                            acc += w[wrow + ky * 3 + kx + 1] * bufl[prow + ky * 10 + kx];
                        }
                    }
                }
                if relu == 1 {
                    if acc < 0 { acc = 0; }
                }
                bufl2[oc * 100 + r * 10 + f + 12] = acc;
            }
        }
    }
}

/// The input convolution, which reads the planes rather than `bufl`.
pub proc conv_in() warp {
    for oc in 0..64 {
        for r in 0..8 {
            for f in 0..8 {
                let acc = b[oc + 1];
                for ic in 0..112 {
                    let wrow = (oc * 112 + ic) * 9;
                    // The window's top left is the padding row and column
                    // before this output, which is where the plane starts:
                    // a cell of the 8x8 is one in from the border, so the
                    // output at r, f reads from r, f of the padded plane.
                    let prow = ic * 100 + r * 10 + f + 1;
                    for ky in 0..3 {
                        for kx in 0..3 {
                            acc += w[wrow + ky * 3 + kx + 1] * planes[prow + ky * 10 + kx];
                        }
                    }
                }
                if acc < 0 { acc = 0; }
                bufl[oc * 100 + r * 10 + f + 12] = acc;
            }
        }
    }
}

/// The value head's squeeze: a 1x1 convolution into `bufv` at 8x8, so the fully
/// connected layer above it can read the map in one run.
pub proc conv1x1(wb: num, bb: num, outch: num) warp {
    for oc in 0..outch {
        for r in 0..8 {
            for f in 0..8 {
                let acc = b[bb + oc + 1];
                for ic in 0..64 {
                    acc += w[wb + oc * 64 + ic + 1] * bufl[ic * 100 + r * 10 + f + 12];
                }
                if acc < 0 { acc = 0; }
                bufv[oc * 64 + r * 8 + f + 1] = acc;
            }
        }
    }
}

pub proc copy_down() warp {
    for c in 0..64 {
        for j in 0..100 {
            bufl[c * 100 + j + 1] = bufl2[c * 100 + j + 1];
        }
    }
}

/// One residual block: two convolutions, a squeeze-excitation unit that gates
/// the second, and the shortcut added back in before the relu.
pub proc block(k: num) warp {
    let wb = block_w(k);
    let bb = block_b(k);
    conv3(wb, bb, 64, 64, 1);
    for c in 0..64 {
        for j in 0..100 { bufx[c * 100 + j + 1] = bufl[c * 100 + j + 1]; }
    }
    copy_down();
    conv3(wb + 36864, bb + 64, 64, 64, 0);

    for c in 0..64 {
        let sum = 0;
        for r in 0..8 {
            for f in 0..8 { sum += bufl2[c * 100 + r * 10 + f + 12]; }
        }
        pool[c + 1] = sum / 64;
    }
    for i in 0..8 {
        let sum = b[bb + 128 + i + 1];
        for c in 0..64 { sum += w[wb + 73728 + i * 64 + c + 1] * pool[c + 1]; }
        if sum < 0 { sum = 0; }
        fc1[i + 1] = sum;
    }
    for i in 0..128 {
        let sum = b[bb + 136 + i + 1];
        for j in 0..8 { sum += w[wb + 74240 + i * 8 + j + 1] * fc1[j + 1]; }
        fc2[i + 1] = sum;
    }
    for c in 0..64 {
        let gate = 1 / (1 + exp(0 - fc2[c + 1]));
        for r in 0..8 {
            for f in 0..8 {
                let j = c * 100 + r * 10 + f + 12;
                let v = bufx[j] + gate * bufl2[j] + fc2[c + 65];
                if v < 0 { v = 0; }
                bufl[j] = v;
            }
        }
    }
}

/// The tower and both heads. The policy head is left in `bufl2` at 80 planes of
/// 8x8 with a border, and `wdl` holds the value, win draw loss.
pub proc forward() warp {
    conv_in();
    for k in 0..6 { block(k); }

    // Both heads read this same value, so the value head goes first: the policy
    // head needs `copy_down` to move its first convolution into `bufl`, and that
    // would otherwise overwrite the tower's output before the value head saw it.
    conv1x1(wbase(3), bbase(3), 32);
    for i in 0..128 {
        let sum = b[bbase(4) + i + 1];
        for j in 0..2048 { sum += w[wbase(4) + i * 2048 + j + 1] * bufv[j + 1]; }
        if sum < 0 { sum = 0; }
        hid[i + 1] = sum;
    }
    for i in 0..3 {
        let sum = b[bbase(5) + i + 1];
        for j in 0..128 { sum += w[wbase(5) + i * 128 + j + 1] * hid[j + 1]; }
        wdl[i + 1] = sum;
    }
    let top = wdl[1];
    if wdl[2] > top { top = wdl[2]; }
    if wdl[3] > top { top = wdl[3]; }
    let total = 0;
    for i in 0..3 {
        wdl[i + 1] = exp(wdl[i + 1] - top);
        total += wdl[i + 1];
    }
    for i in 0..3 { wdl[i + 1] = wdl[i + 1] / total; }

    conv3(wbase(1), bbase(1), 64, 64, 1);
    copy_down();
    conv3(wbase(2), bbase(2), 64, 80, 0);
}

/// The policy index of a move, or -1 when lc0 spends no policy cell on it —
/// which is every knight under-promotion, since maia never makes one.
pub proc policy_index(f: num, t: num, p: num) -> num warp {
    let a = sq64(f);
    let z = sq64(t);
    if side == 1 {
        a = flip64(a);
        z = flip64(z);
    }
    let key = a * 64 + z + 1;
    if p == 0 { return mv_base[key]; }
    if p == 2 { return -1; }
    let slot = 0;
    if p == 4 { slot = 1; }
    if p == 3 { slot = 2; }
    let at = promo_base[key];
    if at < 0 { return -1; }
    return at + slot;
}

/// Run the network on the position on the board and pick the legal move its
/// policy head likes best: the move lc0 without a search plays, the one the
/// check compares against the Python, and the one a game plays. It is how maia
/// is meant to be played — `go nodes 1` with no temperature — and a model
/// answers the same position with the same move every time.
pub proc best_move() warp {
    encode();
    forward();
    let best = 0;
    let first = 1;
    bestf = 0;
    bestt = 0;
    bestp = 0;
    for i in 0..nok {
        let score = move_score(i);
        if score > -1000 {
            if first == 1 || score > best {
                first = 0;
                best = score;
                bestf = okf[i + 1];
                bestt = okt[i + 1];
                bestp = okp[i + 1];
            }
        }
    }
    if bestf == 0 && nok > 0 {
        bestf = okf[1];
        bestt = okt[1];
        bestp = okp[1];
    }
    bestscore = best;
}

/// The policy head's own score for one legal move: the logit in the cell lc0
/// spends on it, which is what the policy is a softmax of. A move lc0 spends no
/// cell on scores below every real logit, which zero does not.
pub proc move_score(i: num) -> num warp {
    let j = policy_index(okf[i + 1], okt[i + 1], okp[i + 1]);
    if j < 0 { return -1000; }
    // `cell_of_move` holds the conv cell itself, plane major over 64 squares, so
    // the plane is the high part and the square the low.
    let at = cell_of_move[j + 1];
    let plane = floor(at / 64);
    let sq = at % 64;
    return bufl2[plane * 100 + floor(sq / 8) * 10 + sq % 8 + 12];
}

// ---------------------------------------------------------------------------
// A count of leaves, for the check
// ---------------------------------------------------------------------------

/// A count of leaves at `root` plies, walked with one row of moves per ply
/// rather than by recursing: a recursive procedure shares one cell per name
/// between all of its calls, so its loop counters would be the same counters at
/// every depth. The rows are stacked by ply instead, and `pf_i` is the move each
/// ply is on.
pub proc perft(root: num) -> num warp {
    if root == 0 { return 1; }
    legal();
    pf_n[1] = nok;
    for i in 0..nok {
        pf_from[MAXMOVE + i + 1] = okf[i + 1];
        pf_to[MAXMOVE + i + 1] = okt[i + 1];
        pf_promo[MAXMOVE + i + 1] = okp[i + 1];
    }
    pf_i[1] = 0;
    pf_total[1] = 0;
    let d = 1;
    let done = 0;
    repeat_until done == 1 {
        if d == 0 {
            done = 1;
        } else {
            if pf_i[d] >= pf_n[d] {
                // This ply is out of moves: step back up, undoing the move that
                // led here and handing the count to the ply above.
                d -= 1;
                if d > 0 {
                    for i in 0..7 { undo[i + 1] = pf_undo[d * 7 + i + 1]; }
                    un_move();
                    pf_total[d] += pf_total[d + 1];
                }
            } else {
                pf_i[d] += 1;
                let k = pf_i[d];
                do_move(pf_from[d * MAXMOVE + k], pf_to[d * MAXMOVE + k], pf_promo[d * MAXMOVE + k]);
                if d == root {
                    pf_total[d] += 1;
                    un_move();
                } else {
                    for i in 0..7 { pf_undo[d * 7 + i + 1] = undo[i + 1]; }
                    d += 1;
                    legal();
                    pf_n[d] = nok;
                    for i in 0..nok {
                        pf_from[d * MAXMOVE + i + 1] = okf[i + 1];
                        pf_to[d * MAXMOVE + i + 1] = okt[i + 1];
                        pf_promo[d * MAXMOVE + i + 1] = okp[i + 1];
                    }
                    pf_i[d] = 0;
                    pf_total[d] = 0;
                }
            }
        }
    }
    return pf_total[1];
}


