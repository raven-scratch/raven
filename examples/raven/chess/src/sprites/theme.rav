// How many piece sets this project carries. Generated by tools/assets.mjs,
// which is the only thing that knows: the sets are whatever
// tools/piecesets/sets.json lists, in that order, and set 0 is cburnett.

pub const SET_N: num = 39;

/// The name of each set, in the order the themes number them.
pub var setname: list<str> = ["cburnett","alpha","anarcandy","caliente","california","cardinal","celtic","chess7","chessnut","companion","cooke","dubrovny","fantasy","firi","fresca","gioco","governor","horsey","icpieces","kiwen-suwi","kosal","leipzig","maestro","merida","minimal-warmth","mpchess","papercut","pirouetti","pixel","reillycraig","rhosgfx","riohacha","shahi-ivory-brown","shapes","spatial","staunty","tatiana","totoy","xkcd"];
