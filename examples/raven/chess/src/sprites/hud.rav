    /// How many cells of the evaluation bar are drawn, so a frame of it can add
    /// the ones it has grown by; the last percentage it showed, so the number
    /// under the bar is only rewritten when it changes; and each side's score of
    /// what it has taken.
    var ebar: num = 0;
    var elastp: num = -1;
    var matw: num = 0;
    var matb: num = 0;

    /// The second the clock line currently shows, so that the page can look at
    /// the clock twenty times a second and write only when it has moved.
    var shown: num = -1;

    /// One run of characters. `draw` is 0 to measure the run and 1 to stamp it
    /// from `x` along the baseline `y`, in stage units per costume unit `scale`,
    /// the stamp being `size` percent of a costume; either way the result is the
    /// run's width in font units.
    ///
    /// A run starts in capitals, which is what the panel is written in, and the
    /// escapes are the whole of the styling: `\c` capitalises the next character,
    /// `\C` and `\l` turn a run of capitals on and off, and `\b` and `\n` turn the
    /// bold weight on and off. A backslash before anything else draws that
    /// character, so `\\` is a backslash.
    ///
    /// Scratch's `=` compares two strings case-insensitively, so a match cannot
    /// tell `a` from `A`: `gindex` finds every letter at its capital's index and
    /// the lowercase glyphs are the same index 26 on, which is what `\l` draws.
    ///
    /// The size is set here, with the glyph's costume already on, and that order
    /// is the whole of why the run lands where it was measured: `set size to`
    /// clamps what it is given to a floor that is a property of the costume the
    /// sprite is *wearing* -- five stage units across it, or a hundred percent
    /// when the costume is too small for five to be a fraction of it. A size set
    /// while wearing the blank pixel, a five by ten bar cell or a twelve unit
    /// turn dot comes back larger than it was asked for, and the glyphs are then
    /// stamped bigger than the advances they were placed at. It is set per
    /// character rather than once, because the costume at the moment of the call
    /// is the only thing the floor is read from.
    proc text_run(s: str, draw: num, x: num, y: num, scale: num, size: num) -> num warp {
        let n = operators::length(s);
        let i = 1;
        let at = x;
        let total = 0;
        let caps = 1;
        let next = 0;
        let bold = 0;
        while i <= n {
            let ch = operators::letter_of(i, s);
            let show = 1;
            if ch == "\\" && i < n {
                let code = operators::letter_of(i + 1, s);
                i += 1;
                if code == "c" { next = 1; show = 0; }
                else if code == "C" { caps = 1; show = 0; }
                else if code == "l" { caps = 0; show = 0; }
                else if code == "b" { bold = 1; show = 0; }
                else if code == "n" { bold = 0; show = 0; }
                else { ch = code; }
            }
            if show == 1 {
                let gi = gindex(ch);
                // The capitals are 1..26 and the lowercase is 26 on; anything
                // else -- a digit, punctuation, the space, an unknown character --
                // has one shape and is left alone.
                if caps == 0 && next == 0 && gi >= 1 && gi <= 26 { gi += 26; }
                next = 0;
                let adv = gadv[gi];
                total += adv;
                if draw == 1 {
                    gdraw(gi, bold);
                    looks::set_size_to(size);
                    // The stamp is centred on its box and the pen starts at
                    // GORIGIN in it, so the box goes this much past the pen.
                    motion::go_to_xy(at + (GBOX / 2 - GORIGIN) * scale, y);
                    pen::stamp();
                    at += adv * GSCALE * scale;
                }
            }
            i += 1;
        }
        return total;
    }

    /// A line of text, centred on `x`, with the middle of its capitals on `y`
    /// and a capital `size` stage units tall. `GCAP` is the capital's ink height
    /// in a costume and `GSCALE` is how many costume units a font unit is, so
    /// the size the sprite is set to is `size` over GCAP, and nothing else is
    /// assumed: every number a caller passes is a length on the stage.
    ///
    /// `\c` capitalises the next character, `\C` and `\l` the case of a run,
    /// `\b` and `\n` its weight, and `\x` draws x itself.
    proc text(s: str, x: num, y: num, size: num) warp {
        let n = operators::length(s);
        if size <= 0 || n == 0 { return; }
        if GCAP <= 0 { return; }
        let sz = size * 100 / GCAP;
        let scale = sz / 100;
        let wide = text_run(s, 0, 0, 0, 0, 0) * GSCALE * scale;
        // The middle of the capitals, not the box, is what `y` names: the
        // cap's middle sits (GBASE - GCAP/2) down the box, the box's middle
        // GBOXH/2, and the stamp is centred on the box.
        text_run(s, 1, x - wide / 2, y + (GBASE - GCAP / 2 - GBOXH / 2) * scale, scale, sz);
        looks::set_size_to(100);
    }

    /// `text`, with the size a caller asks for meaning the largest it may be: a
    /// string too wide for the box it is drawn in is shrunk to fit, so a name
    /// that is longer than the layout expected still reads instead of running
    /// over what is beside it. The run is measured once here and once in `text`,
    /// which is the price of the guarantee.
    proc text_fit(s: str, x: num, y: num, size: num, maxw: num) warp {
        if size <= 0 || maxw <= 0 { return; }
        let wide = text_run(s, 0, 0, 0, 0, 0) * GSCALE * (size / GCAP);
        let fit = size;
        if wide > maxw { fit = size * maxw / wide; }
        text(s, x, y, fit);
    }

    /// One costume, stamped at the size it is meant to be seen at. The costume
    /// has to be on already -- a stamp has no way to name one -- and the size
    /// has to be set with it on, which is what this does: setting a size is
    /// clamped against the current costume, so the two belong in this order and
    /// as close together as this.
    proc stamp_at(x: num, y: num, size: num) warp {
        looks::set_size_to(size);
        motion::go_to_xy(x, y);
        pen::stamp();
    }

    /// One of the menu's and the settings page's wide buttons: the button, and
    /// its label written on it, shrunk if the label is wider than the button.
    /// The costume is switched here rather than by the caller, so a button can
    /// never wear whatever the last label left behind.
    proc button(x: num, y: num, label: str) warp {
        looks::switch_costume_to("btn-wide");
        stamp_at(x, y, 52);
        text_fit(label, x, y, 8.2, 92);
    }

    /// One of the panel's hairlines.
    proc rule(y: num) warp {
        looks::switch_costume_to("rule");
        stamp_at(PANEL, y, 100);
    }

    /// Who plays a side, the way `board.rav` names it: a target cannot read
    /// another target's procedures, so the four lines are here as well.
    proc seat_of(s: num) -> num warp {
        if s == 0 { return wseat; }
        return bseat;
    }

    proc seat_name(v: num) -> str warp {
        if v == 0 { return "YOU"; }
        return f"{elos[v]}";
    }

    /// The rank digits up the left of the board and the file letters under it,
    /// both in the margin round it so that neither is drawn over a piece. Both
    /// turn with the board: the digit of rank 1 is drawn beside whichever end of
    /// the board rank 1 now is, and a file letter always sits under the file it
    /// names.
    proc coordinates() warp {
        for i in 0..8 {
            let row = i;
            if flipped == 1 { row = 7 - i; }
            text(f"{i + 1}", EDGE_X - 12, row_y(row),8.3);
        }
        for i in 0..8 {
            let col = i;
            if flipped == 1 { col = 7 - i; }
            text(operators::letter_of(i + 1, "abcdefgh"), col_x(col), EDGE_Y - 12,8.3);
        }
    }

    /// What each side has taken, in the values a pawn, a knight, a bishop, a
    /// rook and a queen are worth; a king is never taken.
    proc material() warp {
        matw = 0;
        matb = 0;
        let nw = capw.len();
        for i in 0..nw {
            let k = (capw[i + 1] - 1) % 6 + 1;
            if k == 1 { matw += 1; }
            if k == 2 || k == 3 { matw += 3; }
            if k == 4 { matw += 5; }
            if k == 5 { matw += 9; }
        }
        let nb = capb.len();
        for i in 0..nb {
            let k = (capb[i + 1] - 1) % 6 + 1;
            if k == 1 { matb += 1; }
            if k == 2 || k == 3 { matb += 3; }
            if k == 4 { matb += 5; }
            if k == 5 { matb += 9; }
        }
    }

    /// The pieces a side has taken, laid out along its row of the panel at a
    /// pitch that closes up as the row fills, so fifteen of them still fit, and
    /// what that side is up on material, which only the side that is up shows.
    ///
    /// This is the one place a piece is not stamped at the size of its costume:
    /// an icon is 24 units and the pitch it is laid out on falls below that as
    /// the row fills, so a crowded row draws it smaller. Down is the harmless
    /// direction, and the alternative is fifteen costumes per piece per set.
    proc taken(which: num, y: num) warp {
        let n = capb.len();
        if which == 0 { n = capw.len(); }
        if n > 0 {
            let step = CAP_W / n;
            if step > CAP_STEP { step = CAP_STEP; }
            let size = 100;
            if step < P_ICON { size = 100 * step / P_ICON; }
            let left = CAP_CX - ((n - 1) * step) / 2;
            for i in 0..n {
                let p = capb[i + 1];
                if which == 0 { p = capw[i + 1]; }
                // Size 2: one icon of the capture row.
                take(pset, p, 2);
                stamp_at(left + i * step, y, size);
            }
        }
        let diff = matw - matb;
        if which == 1 { diff = -diff; }
        if diff > 0 { text(f"+{diff}", PANEL + 62, y,7.1); }
    }

    /// One player's card: the side, who plays it, and a dot when it is their
    /// turn. `s` is 0 for white and 1 for black, and the top card is whichever
    /// side the board is showing at the top.
    proc seat_card(y: num, s: num) warp {
        looks::switch_costume_to("seat");
        stamp_at(PANEL, y, 100);
        if turn == s && mode != 0 {
            looks::switch_costume_to("turn-dot");
            stamp_at(PANEL - 64, y, 100);
        }
        if s == 0 {
            text("WHITE", PANEL - 38, y + 8,7.1);
        } else {
            text("BLACK", PANEL - 38, y + 8,7.1);
        }
        text(seat_name(seat_of(s)), PANEL + 34, y - 6,10.3);
    }

    /// How the game is going, for white, as a bar: a draw counts for half of
    /// each side, which is what a score is. The track is opaque, so stamping it
    /// again is what erases the fill of the frame before.
    proc evals() warp {
        looks::switch_costume_to("bar-track");
        stamp_at(PANEL, P_EVAL, 100);
        let n = operators::round(eshare * 26);
        if n < 0 { n = 0; }
        if n > 26 { n = 26; }
        looks::switch_costume_to("bar-cell");
        for i in 0..n { stamp_at(EVAL_X0 + i * EVAL_DX, P_EVAL, 100); }
        ebar = n;
        eval_label();
    }

    proc eval_label() warp {
        let p = operators::round(eshare * 100);
        elastp = p;
        text(f"{p}% WHITE", PANEL, P_EVAL_T,8.2);
    }

    /// A frame of the bar. Nothing is stamped at all while the share rounds to
    /// the same number of cells, and when it grows the new cells go on top of
    /// the old ones; only a shrinking share has to be erased first.
    proc eval_tick() warp {
        let n = operators::round(eshare * 26);
        if n < 0 { n = 0; }
        if n > 26 { n = 26; }
        if n != ebar {
            if n > ebar {
                looks::switch_costume_to("bar-cell");
                for i in ebar..n { stamp_at(EVAL_X0 + i * EVAL_DX, P_EVAL, 100); }
            } else {
                looks::switch_costume_to("bar-track");
                stamp_at(PANEL, P_EVAL, 100);
                looks::switch_costume_to("bar-cell");
                for i in 0..n { stamp_at(EVAL_X0 + i * EVAL_DX, P_EVAL, 100); }
            }
            ebar = n;
        }
        let p = operators::round(eshare * 100);
        if p != elastp {
            elastp = p;
            looks::switch_costume_to("patch");
            stamp_at(PANEL, P_EVAL_T, 100);
            text(f"{p}% WHITE", PANEL, P_EVAL_T,8.2);
        }
    }

    /// The last six moves, two plies to a line, and how long the game has run.
    proc moves() warp {
        let n = log.len();
        let start = n - 12;
        if start < 0 { start = 0; }
        let row = 0;
        let i = start;
        repeat_until i >= n {
            let label = floor(i / 2) + 1;
            // \l because a run starts in capitals and a move is written in lower.
            let line = f"\\l{label}.{log[i + 1]}";
            if i + 1 < n { line = f"{line} {log[i + 2]}"; }
            text(line, PANEL, P_MOVE - row * P_MOVE_DY,9.2);
            row += 1;
            i += 2;
        }
    }

    proc clock_text() -> str warp {
        let m = floor(secs / 60);
        let s = secs % 60;
        if s < 10 { return f"{m}:0{s}"; }
        return f"{m}:{s}";
    }

    proc clock_line() warp {
        shown = secs;
        text(f"MOVE {floor(log.len() / 2) + 1}   {clock_text()}", PANEL, P_CLOCK,8);
    }

    /// The three buttons at the foot of the panel: a new game, turning the board
    /// round, and the way back to the menu — which is a button and not, as it
    /// was, a press anywhere on the board at the end of a game.
    proc buttons() warp {
        looks::switch_costume_to("btn");
        stamp_at(NEW_X, P_BTN, BTN_SIZE);
        stamp_at(FLIP_X, P_BTN, BTN_SIZE);
        stamp_at(MENU_X, P_BTN, BTN_SIZE);
        // All three buttons are stamped before any label: a label leaves the
        // glyph it ended on, and a button stamped after one would be that glyph.
        text_fit("NEW", NEW_X, P_BTN, 8.2, BTN_W);
        text_fit("FLIP", FLIP_X, P_BTN, 8.2, BTN_W);
        text_fit("MENU", MENU_X, P_BTN, 8.2, BTN_W);
    }

    proc result() -> str warp {
        if winner == -1 { return "DRAW"; }
        if wseat == 0 && bseat == 0 {
            if winner == 0 { return "WHITE WINS"; }
            return "BLACK WINS";
        }
        if wseat == 0 || bseat == 0 {
            if winner == human { return "YOU WIN"; }
            return "YOU LOSE";
        }
        if winner == 0 { return "WHITE WINS"; }
        return "BLACK WINS";
    }

    proc reason_text() -> str warp {
        if reason == 1 {
            if winner == 0 { return "BLACK IS CHECKMATED"; }
            return "WHITE IS CHECKMATED";
        }
        if reason == 2 { return "NO LEGAL MOVES"; }
        if reason == 3 { return "FIFTY MOVE RULE"; }
        return "THREE FOLD REPETITION";
    }

    /// Everything the game state is: two player cards with what they have taken
    /// between them, the evaluation, the last moves, whose move it is, and how
    /// long the game has run.
    proc panel() warp {
        looks::switch_costume_to("frame");
        stamp_at(BOARD_CX, 0, 100);
        looks::switch_costume_to("panel");
        stamp_at(PANEL, 0, 100);

        material();
        seat_card(P_SEAT_A, 1 - flipped);
        taken(1 - flipped, P_CAP_A);
        rule(P_RULE_A);
        evals();
        rule(P_RULE_B);
        moves();
        rule(P_RULE_C);
        text_fit(hint, PANEL, P_HINT, 10.2, P_W);
        clock_line();
        taken(flipped, P_CAP_B);
        seat_card(P_SEAT_B, flipped);
        buttons();
    }

    /// One side's card on the menu: the side, and one cell per seat, seat 0
    /// being you and seats 1..9 the nine networks. The cell of the seat this
    /// side is at is the lit one and its name is bold, so the row is also the
    /// readout; every other cell is a choice, and a press on one takes it.
    ///
    /// All ten cells are stamped before any name: a name is a run of glyph
    /// costumes, and a cell stamped after one would be stamped as a glyph.
    proc menu_row(cy: num, s: num) warp {
        looks::switch_costume_to("menu-seat");
        stamp_at(0, cy, 100);
        if s == 0 {
            text("WHITE", M_SEAT_LABEL_X, cy, 7.5);
        } else {
            text("BLACK", M_SEAT_LABEL_X, cy, 7.5);
        }
        let v = bseat;
        if s == 0 { v = wseat; }
        for i in 0..M_SEAT_N {
            if i == v {
                looks::switch_costume_to("cell-on");
            } else {
                looks::switch_costume_to("cell");
            }
            stamp_at(M_SEAT_X0 + i * M_SEAT_DX, cy, M_SEAT_CELL);
        }
        for i in 0..M_SEAT_N {
            let name = f"{elos[i]}";
            if i == 0 { name = "YOU"; }
            let x = M_SEAT_X0 + i * M_SEAT_DX;
            if i == v {
                text_fit(f"\\b{name}", x, cy, M_SEAT_TEXT, M_SEAT_W);
            } else {
                text_fit(name, x, cy, M_SEAT_TEXT, M_SEAT_W);
            }
        }
    }

    proc menu() warp {
        text("CHESS", 0, M_TITLE,29.6);
        text("PLAY THE MAIA NETWORKS", 0, M_SUB,7.1);
        menu_row(M_CARD_A, 0);
        menu_row(M_CARD_B, 1);
        button(M_PLAY_X, M_PLAY, "PLAY");
        button(M_SET_X, M_PLAY, "SETTINGS");
        text("CLICK A SEAT FOR EACH SIDE", 0, M_HINT,7.1);
    }

    /// One square of a palette, light or dark.
    proc pal(i: num, lit: num) warp {
        let k = i * 2 + lit;
        match k {
            0 => { looks::switch_costume_to("bs0l"); },
            1 => { looks::switch_costume_to("bs0d"); },
            2 => { looks::switch_costume_to("bs1l"); },
            3 => { looks::switch_costume_to("bs1d"); },
            4 => { looks::switch_costume_to("bs2l"); },
            5 => { looks::switch_costume_to("bs2d"); },
            6 => { looks::switch_costume_to("bs3l"); },
            _ => { looks::switch_costume_to("bs3d"); }
        }
    }

    /// A board palette, as the two squares it is: small, on its button.
    proc swatch(i: num, x: num, y: num) warp {
        pal(i, 1);
        stamp_at(x - 8, y, 48);
        pal(i, 0);
        stamp_at(x + 8, y, 48);
    }

    /// The settings page: which pieces, and which board. It is a page and not a
    /// panel over the game, so the board is not drawn at all behind it.
    ///
    /// Every cell of the grid wears its own set's knight, so the grid is the
    /// preview: the page shows all thirty-nine sets rather than naming one. The
    /// name under the grid is the selected set's, and it sits below the last row
    /// rather than on it.
    proc settings() warp {
        text("SETTINGS", 0, S_TITLE_Y,14.3);
        if SET_N > 1 {
            text("PIECE SET", 0, S_SUB_Y,7.1);
            for i in 0..SET_N {
                let col = i % S_COLS;
                let row = floor(i / S_COLS);
                let x = S_GRID_X + col * S_STEP;
                let y = S_GRID_Y - row * S_STEP;
                if i == pset {
                    looks::switch_costume_to("cell-on");
                } else {
                    looks::switch_costume_to("cell");
                }
                stamp_at(x, y, S_CELL);
                // The knight of this set, on its own cell: `take` switches to
                // the piece's costume for a settings cell (size 3), and the
                // stamp after it is at that costume's own size.
                take(i, 2, 3);
                stamp_at(x, y, 100);
            }
            // A set's name is written in the lowercase it is spelled in.
            let shown = "cburnett";
            if pset < SET_N { shown = setname[pset + 1]; }
            text_fit(f"\\l{shown}", 0, S_NAME_Y, 9, 260);
        } else {
            text("ONE PIECE SET IS BUILT IN", 0, S_SUB_Y,7.1);
        }
        text("BOARD", 0, B_TITLE_Y,7.1);
        for i in 0..4 {
            let x = B_ROW_X + i * B_ROW_DX;
            if i == bstyle {
                looks::switch_costume_to("cell-on");
            } else {
                looks::switch_costume_to("cell");
            }
            stamp_at(x, B_ROW_Y, B_ROW_CELL);
            swatch(i, x, B_ROW_Y);
        }
        button(M_BACK_X, M_BACK_Y, "BACK");
    }

    proc over() warp {
        looks::switch_costume_to("veil");
        stamp_at(0, 0, 100);
        text(result(), BOARD_CX, 40,17.2);
        text(hint, BOARD_CX, 0,11.2);
        text(reason_text(), BOARD_CX, -32,8.6);
        text("CLICK AWAY FOR THE MENU", BOARD_CX, -72,9.2);
    }

    /// A frame of the evaluation bar. The stage declares this message by
    /// broadcasting it once at the flag, so the page is checked here: a bar
    /// stamped while the menu is the page would be a bar over the menu.
    on broadcast_received("eval") {
        if page == 1 { eval_tick(); }
    }

    on broadcast_received("hud") {
        if page == 0 { menu(); }
        if page == 2 { settings(); }
        if page == 1 {
            coordinates();
            // The end of a game is the panel once more, with a veil and the
            // result card over it: the panel is stamped exactly once, and the
            // veil dims it and the board together.
            panel();
            if mode == 3 { over(); }
        }
    }

    /// The pen draws this sprite, and a hidden sprite still stamps.
    ///
    /// The clock is looked at here rather than being broadcast at: the board
    /// cannot say a second has passed while a bot's turn is running, because a
    /// turn runs inside one frame of the board's loop, and a message sent from
    /// inside the search would be a message block in the middle of the one place
    /// the compiler is working. A comparison twenty times a second costs
    /// nothing, and a rewrite happens once a second whether the board is busy or
    /// not. This script never ends, which is what a forever loop is.
    on flag_clicked {
        looks::hide();
        looks::set_size_to(100);
        looks::switch_costume_to("blank");
        forever {
            if page == 1 && (mode == 1 || mode == 2) && secs != shown {
                looks::switch_costume_to("patch");
                stamp_at(PANEL, P_CLOCK, 100);
                clock_line();
            }
            control::wait(0.05);
        }
    }
}
