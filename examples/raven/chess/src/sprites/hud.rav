// The panel and every character on the stage.
//
// A Scratch costume's name is written as a literal, so a character cannot name
// its own costume; `glyphs.rav` is one arm per character and weight instead,
// which is also the only place the font's order is written down. The costumes
// and that module both come from `tools/glyphs.py`.
//
// Everything here is stamped with the pen, on top of what the board left: the
// frame, the panel beside it, the coordinates round the board and the menu or
// the end-of-game card over it. Rows are laid out from `layout.rav`'s numbers
// rather than eyeballed, and a line of text is one stamp per character at that
// character's own advance, on the line's baseline.
//
// A stamp draws whatever costume the sprite happens to be wearing and at
// whatever size it happens to be, so every stamp here is immediately preceded
// by the costume it means and followed by a size set with that costume on.
// Scratch clamps a size to a floor read from the current costume, so the order
// of those two is not a style: it is what makes a run of text land where it was
// measured. `stamp_at`, `button` and `text_run` are the three places that do it.
//
// The panel is touched three ways. A whole redraw comes in as `hud`, after the
// board has cleared the layer it stamps on. The evaluation bar moves on its own
// and comes in as `eval`, a frame at a time, adding the cells the bar has grown
// by rather than restamping it. The clock comes in as `clock`, once a second,
// and rewrites one line on a square of the panel's own colour.
//
// Nothing here is ever visible: the sprite is hidden, and a hidden sprite still
// stamps, which is what keeps it from being one more thing on the stage.

use sprites::pieces;
use sprites::glyphs;
use sprites::theme;
use layout;
use net;

sprite "Hud" {
    costume "blank" = "assets/blank.svg";
    costume "panel" = "assets/panel.svg";
    costume "frame" = "assets/frame.svg";
    costume "seat" = "assets/seat.svg";
    costume "turn-dot" = "assets/turn-dot.svg";
    costume "patch" = "assets/patch.svg";
    costume "btn" = "assets/btn.svg";
    costume "btn-wide" = "assets/btn-wide.svg";
    costume "menu-seat" = "assets/menu-seat.svg";
    costume "cell" = "assets/cell.svg";
    costume "cell-on" = "assets/cell-on.svg";
    costume "bs0l" = "assets/bs0l.svg";
    costume "bs0d" = "assets/bs0d.svg";
    costume "bs1l" = "assets/bs1l.svg";
    costume "bs1d" = "assets/bs1d.svg";
    costume "bs2l" = "assets/bs2l.svg";
    costume "bs2d" = "assets/bs2d.svg";
    costume "bs3l" = "assets/bs3l.svg";
    costume "bs3d" = "assets/bs3d.svg";
    costume "rule" = "assets/rule.svg";
    costume "veil" = "assets/veil.svg";
    costume "bar-track" = "assets/bar-track.svg";
    costume "bar-cell" = "assets/bar-cell.svg";
    // BEGIN PIECE COSTUMES
    // Everything between these two markers is generated by tools/assets.mjs:
    // one PNG per piece per size it is stamped at, and every one of them is
    // stamped at size 100. The board draws `p` and `d`, the panel `c` and
    // `s`; all four are here because `pieces.rav` names them all and a module
    // is compiled into every target that uses it. Do not edit it by hand.
    // 36 units: p<set><piece>
    // 40 units: d<set><piece>
    // 24 units: c<set><piece>
    // 22 units: s<set><piece>
    costume "p0wP" = "assets/p0wP.png";
    costume "d0wP" = "assets/d0wP.png";
