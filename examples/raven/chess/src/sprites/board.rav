    sound "move" = "assets/move.wav";
    sound "capture" = "assets/capture.wav";
    sound "check" = "assets/check.wav";
    sound "start" = "assets/start.wav";
    sound "end" = "assets/end.wav";

    /// Whether the mouse was already down last time round the loop, so one press
    /// is one click, and which square it was over, so the hover tint is only
    /// redrawn when it moves. `seen_click` is the count of clicks the button
    /// thread has already acted on: a script that ends in `forever` cannot hold
    /// a `let`, because its scope would have to be popped after the cap.
    var held: num = 0;
    var hover: num = 0;
    var seen_click: num = 0;

    // The piece in flight. `aon` is whether there is one, `adrag` whether the
    // pointer is still holding it, and `ahide` the square it must not be drawn
    // on because it is being drawn where the system has carried it instead.
    //
    // Its position and its goal are in the board's own space, the one the squares
    // are numbered in and the one a square's centre is a constant of, and the
    // board is looked at through `fx` and `fy`: with the board turned round the
    // piece in the air is drawn where the board draws that place now, and a turn
    // in the middle of a flight needs no position to be converted, because none
    // of the four numbers moved.
    var aon: num = 0;
    var adrag: num = 0;
    var ahide: num = 0;
    var afrom: num = 0;
    var apiece: num = 0;
    var ax: num = 0;
    var ay: num = 0;
    var avx: num = 0;
    var avy: num = 0;
    var atx: num = 0;
    var aty: num = 0;
    var apx: num = 0;
    var apy: num = 0;
    /// Natural frequency, damping and initial response, in the terms the motion
    /// is designed in: how fast it answers, how it settles, and whether it moves
    /// off the moment the goal does.
    var af: num = 4.5;
    var az: num = 0.9;
    var ar: num = 0;
    var alast: num = 0;

    // The evaluation bar, which is the same system on one axis, and when the
    // game started, which is what the panel's clock counts from.
    var etarget: num = 0.5;
    var eprev: num = 0.5;
    var evv: num = 0;
    var eon: num = 0;
    var elast: num = 0;

    const PI: num = 3.141592653589793;
    const TAU2: num = 39.47841760435743;
    const TSTOP: num = 0.1;

    proc screen_col(m: num) -> num warp {
        let c = m % 10 - 1;
        if flipped == 1 { c = 7 - c; }
        return c;
    }

    proc screen_row(m: num) -> num warp {
        let r = floor(m / 10) - 2;
        if flipped == 1 { r = 7 - r; }
        return r;
    }

    /// Where a square's centre is, without turning the board round.
    fn raw_x(m: num) -> num { col_x(m % 10 - 1) }

    fn raw_y(m: num) -> num { row_y(floor(m / 10) - 2) }

    /// Where a square's centre is, as the board is drawn.
    proc home_x(m: num) -> num warp {
        return fx(raw_x(m));
    }

    proc home_y(m: num) -> num warp {
        return fy(raw_y(m));
    }

    /// The board's own space and the stage's, either way: the mirror the board is
    /// looked at through when it is turned round, about the middle of the board.
    /// Turning it round twice is where it started, so this is its own inverse,
    /// and a pointer read into the board's space comes back out the way a piece
    /// goes in.
    proc fx(x: num) -> num warp {
        if flipped == 1 { return 2 * (LEFT + SQUARE * 3.5) - x; }
        return x;
    }

    proc fy(y: num) -> num warp {
        if flipped == 1 { return 2 * (BOTTOM + SQUARE * 3.5) - y; }
        return y;
    }

    proc place(m: num) warp {
        motion::go_to_xy(home_x(m), home_y(m));
    }

    /// The costume of one square's tile, for the palette the settings picked.
    /// Eight names, four palettes of two, chosen by a number that is the palette
    /// doubled plus whether the square is light.
    proc tile(m: num) warp {
        let k = bstyle * 2;
        if (rank_of(m) + file_of(m)) % 2 == 1 { k = k + 1; }
        match k {
            0 => { looks::switch_costume_to("bs0d"); },
            1 => { looks::switch_costume_to("bs0l"); },
            2 => { looks::switch_costume_to("bs1d"); },
            3 => { looks::switch_costume_to("bs1l"); },
            4 => { looks::switch_costume_to("bs2d"); },
            5 => { looks::switch_costume_to("bs2l"); },
            6 => { looks::switch_costume_to("bs3d"); },
            _ => { looks::switch_costume_to("bs3l"); }
        }
    }

    proc draw_tiles() warp {
        for r in 0..8 {
            for f in 0..8 {
                let m = cell(r, f);
                tile(m);
                place(m);
                pen::stamp();
            }
        }
    }

    /// The square the pointer is over, the move just played, the ring round a
    /// king in check, the tint under the piece the player picked up, and a dot
    /// or a ring on every square that piece may go to.
    proc draw_marks() warp {
        if mode == 1 && hover != 0 && adrag == 0 {
            looks::switch_costume_to("hl-hover");
            place(hover);
            pen::stamp();
        }
        if lastf != 0 {
            looks::switch_costume_to("hl-last");
            place(lastf);
            pen::stamp();
            place(lastt);
            pen::stamp();
        }
        if checking != 0 {
            looks::switch_costume_to("hl-check");
            place(checking);
            pen::stamp();
        }
        if sel != 0 {
            looks::switch_costume_to("hl-sel");
            place(sel);
            pen::stamp();
            for i in 0..nok {
                if okf[i + 1] == sel {
                    let t = okt[i + 1];
                    let capture = board[atc(t)] != 0;
                    if t == ep && file_of(t) != file_of(sel) { capture = true; }
                    if capture {
                        looks::switch_costume_to("ring");
                    } else {
                        looks::switch_costume_to("dot");
                    }
                    place(t);
                    pen::stamp();
                }
            }
        }
    }

    proc draw_pieces() warp {
        for r in 0..8 {
            for f in 0..8 {
                let m = cell(r, f);
                if aon == 0 || m != ahide {
                    let p = board[atc(m)];
                    if p != 0 {
                        // Size 0: a piece on a square, which is the size of that
                        // costume, so the stamp is at 100 like every other one here.
                        take(pset, p, 0);
                        place(m);
                        looks::set_size_to(100);
                        pen::stamp();
                    }
                }
            }
        }
    }

    /// The squares a piece one square wide standing at `x`, `y` covers: four at
    /// most. Repainting them is how a flight erases where it has just been
    /// without clearing the layer, which would take the panel and the page with
    /// it — and it is what keeps a frame of it to a dozen stamps instead of the
    /// three hundred a whole redraw costs. The box is measured on the stage, so
    /// its rows and columns are screen ones and the square they name is whatever
    /// `screen_cell` says: with the board turned round they are not the same.
    proc repaint_box(x: num, y: num) warp {
        let c0 = floor((x - SQUARE / 2 - EDGE_X) / SQUARE);
        let c1 = floor((x + SQUARE / 2 - EDGE_X - 0.001) / SQUARE);
        let r0 = floor((y - SQUARE / 2 - EDGE_Y) / SQUARE);
        let r1 = floor((y + SQUARE / 2 - EDGE_Y - 0.001) / SQUARE);
        if c0 < 0 { c0 = 0; }
        if r0 < 0 { r0 = 0; }
        if c1 > 7 { c1 = 7; }
        if r1 > 7 { r1 = 7; }
        for r in r0..(r1 + 1) {
            for c in c0..(c1 + 1) { paint_square(screen_cell(r, c)); }
        }
        looks::set_size_to(100);
    }

    /// The piece in flight, stamped where the system has carried it, a shade
    /// larger while the pointer holds it.
    proc stamp_flight() warp {
        // Size 1 while the pointer is holding the piece, size 0 once it is not:
        // the held one is a costume of its own, a shade larger than the square.
        take(pset, apiece, adrag);
        looks::set_size_to(100);
        motion::go_to_xy(fx(ax), fy(ay));
        pen::stamp();
    }

    /// The four promotion choices are stacked in the promotion square's column,
    /// on a slab so they read as one thing: upwards from the square when it is
    /// on the far half of the board and downwards from it otherwise. Which half
    /// is the drawn one, so a square on the far half of a board turned round is
    /// near the bottom of the stage.
    proc promo_base() -> num warp {
        let r = screen_row(promosq);
        if r >= 4 { return r - 4; }
        return r;
    }

    proc draw_promo() warp {
        if promosq != 0 {
            let base = promo_base();
            let x = LEFT + screen_col(promosq) * SQUARE;
            let top = BOTTOM + (base + 3) * SQUARE + 4;
            looks::switch_costume_to("promo-box");
            motion::go_to_xy(x, top - (SQUARE * 4 + 8) / 2);
            pen::stamp();
            let q = 5;
            if side == 1 { q = 11; }
            for k in 0..4 {
                take(pset, q - k, 0);
                looks::set_size_to(100);
                motion::go_to_xy(x, BOTTOM + (base + k) * SQUARE);
                pen::stamp();
            }
        }
    }

    /// One square of the board, painted in place: its tile, then whatever the
    /// board draws over that tile, then the piece standing on it. A hover that
    /// crosses a line repaints the two squares it crossed rather than clearing
    /// the layer, which would take the panel with it.
    proc paint_square(m: num) warp {
        looks::set_size_to(100);
        tile(m);
        place(m);
        pen::stamp();
        if lastf == m || lastt == m {
            looks::switch_costume_to("hl-last");
            place(m);
            pen::stamp();
        }
        if checking == m {
            looks::switch_costume_to("hl-check");
            place(m);
            pen::stamp();
        }
        if sel == m {
            looks::switch_costume_to("hl-sel");
            place(m);
            pen::stamp();
        }
        if mode == 1 && hover == m && adrag == 0 {
            looks::switch_costume_to("hl-hover");
            place(m);
            pen::stamp();
        }
        if sel != 0 {
            for i in 0..nok {
                if okf[i + 1] == sel && okt[i + 1] == m {
                    let capture = board[atc(m)] != 0;
                    if m == ep && file_of(m) != file_of(sel) { capture = true; }
                    if capture {
                        looks::switch_costume_to("ring");
                    } else {
                        looks::switch_costume_to("dot");
                    }
                    place(m);
                    pen::stamp();
                }
            }
        }
        let skip = 0;
        if aon == 1 && ahide == m { skip = 1; }
        if skip == 0 {
            let p = board[atc(m)];
            if p != 0 {
                take(pset, p, 0);
                place(m);
                looks::set_size_to(100);
                pen::stamp();
            }
        }
    }

    /// The board and nothing else. A page that is not the board draws no board:
    /// the layer is cleared and left empty for the panel the hud stamps on it.
    proc draw_board() warp {
        pen::clear();
        if page != 1 { return; }
        looks::set_size_to(100);
        draw_tiles();
        draw_marks();
        draw_pieces();
        draw_promo();
        looks::switch_costume_to("blank");
    }

    /// The board, and then the page stamped over it: the page is a second
    /// sprite, so the broadcast is what puts it above the ink the board just
    /// laid down.
    proc draw() warp {
        turn = side;
        draw_board();
        if aon == 1 { stamp_flight(); }
        events::broadcast_and_wait("hud");
    }

    // -----------------------------------------------------------------------
    // Motion
    // -----------------------------------------------------------------------

    /// Send the piece in flight to a square and let it settle there, with the
    /// feel asked for. The square is the goal, not where the square is now: the
    /// board can be turned round before the piece gets there.
    proc aim(m: num, freq: num, zeta: num, resp: num) warp {
        atx = raw_x(m);
        aty = raw_y(m);
        apx = atx;
        apy = aty;
        ahide = m;
        af = freq;
        az = zeta;
        ar = resp;
        alast = sensing::timer();
        aon = 1;
        stamp_flight();
    }

    /// A frame of the piece in flight: a second order system stepped forwards by
    /// the time the last frame actually took. When that is too long for the
    /// frequency asked for, the step is divided until it is not, which is the
    /// difference between a spring that settles and one that flies apart.
    ///
    /// The frame stamps twice and clears nothing: where the piece was is painted
    /// back over — the squares under it, their tints, and whatever piece was on
    /// them — and then the piece is stamped where it now is.
    proc anim_frame() warp {
        let now = sensing::timer();
        let span = now - alast;
        alast = now;
        if span > TSTOP { span = TSTOP; }
        if span < 0.004 { span = 0.004; }

        repaint_box(fx(ax), fy(ay));

        let k1 = az / (PI * af);
        let k2 = 1 / (TAU2 * af * af);
        let k3 = ar * az / (2 * PI * af);
        let xd = 0;
        let yd = 0;
        if adrag == 1 {
            xd = (atx - apx) / span;
            yd = (aty - apy) / span;
        }
        apx = atx;
        apy = aty;

        let critical = sqrt(4 * k2 + k1 * k1) - k1;
        if critical < 0.0005 { critical = 0.0005; }
        let steps = ceil(span / critical);
        if steps < 1 { steps = 1; }
        if steps > 8 { steps = 8; }
        let dt = span / steps;
        for i in 0..steps {
            avx += dt * (atx + k3 * xd - ax - k1 * avx) / k2;
            ax += dt * avx;
            avy += dt * (aty + k3 * yd - ay - k1 * avy) / k2;
            ay += dt * avy;
        }
        if adrag == 0 && abs(atx - ax) < 0.5 && abs(aty - ay) < 0.5 {
            if abs(avx) < 4 && abs(avy) < 4 {
                ax = atx;
                ay = aty;
                avx = 0;
                avy = 0;
                aon = 0;
                ahide = 0;
                stamp_flight();
                return;
            }
        }
        stamp_flight();
    }

    /// The evaluation bar, stepped the same way and on one axis.
    proc eval_frame() warp {
        let now = sensing::timer();
        let span = now - elast;
        elast = now;
        if span > TSTOP { span = TSTOP; }
        if span < 0.004 { span = 0.004; }

        let freq = 3.2;
        let zeta = 0.9;
        let k1 = zeta / (PI * freq);
        let k2 = 1 / (TAU2 * freq * freq);
        let xd = (etarget - eprev) / span;
        eprev = etarget;

        let critical = sqrt(4 * k2 + k1 * k1) - k1;
        let steps = ceil(span / critical);
        if steps < 1 { steps = 1; }
        if steps > 8 { steps = 8; }
        let dt = span / steps;
        for i in 0..steps {
            evv += dt * (etarget - eshare - k1 * evv) / k2;
            eshare += dt * evv;
        }
        if abs(etarget - eshare) < 0.002 && abs(evv) < 0.03 {
            eshare = etarget;
            evv = 0;
            eon = 0;
        }
    }

    // -----------------------------------------------------------------------
    // The game
    // -----------------------------------------------------------------------

    /// Who plays a side: 0 is you and 1..9 is a bot.
    proc seat_of(s: num) -> num warp {
        if s == 0 { return wseat; }
        return bseat;
    }

    proc is_bot(s: num) -> bool warp {
        return seat_of(s) != 0;
    }

    proc seat_name(v: num) -> str warp {
        if v == 0 { return "YOU"; }
        return f"{elos[v]}";
    }

    /// The bot the side to move needs, unpacked if it is not the one loaded.
    proc ensure_bot() warp {
        let v = seat_of(side);
        if v != 0 && bot != v - 1 {
            load_bot(v - 1);
        }
    }

    proc square_name(m: num) -> str warp {
        let letter = operators::letter_of(file_of(m) + 1, "abcdefgh");
        return f"{letter}{rank_of(m) + 1}";
    }

    proc promo_letter(p: num) -> str warp {
        if p == 5 { return "q"; }
        if p == 4 { return "r"; }
        if p == 3 { return "b"; }
        return "n";
    }

    proc record(f: num, t: num, p: num) warp {
        let text = f"{square_name(f)}{square_name(t)}";
        if p != 0 { text = f"{text}{promo_letter(p)}"; }
        log.push(text);
    }

    /// Lay a move down, remember what it took, and let the piece fly to where it
    /// landed. A piece that was being dragged keeps the speed it had, so
    /// dropping one flicks it rather than restarting the motion from rest.
    proc play(f: num, t: num, p: num) warp {
        let captured = board[atc(t)];
        let kind = (board[atc(f)] - 1) % 6 + 1;
        if adrag == 0 {
            ax = raw_x(f);
            ay = raw_y(f);
            avx = 0;
            avy = 0;
        }
        if kind == 1 && ep != 0 && t == ep && file_of(f) != file_of(t) {
            if side == 0 { capw.push(7); } else { capb.push(1); }
        } else {
            if captured != 0 {
                if side == 0 { capw.push(captured); } else { capb.push(captured); }
            }
        }
        do_move(f, t, p);
        commit();
        lastf = f;
        lastt = t;
        sel = 0;
        promosq = 0;
        hover = 0;
        adrag = 0;
        apiece = board[atc(t)];
        aim(t, 4.5, 0.9, 0);
        record(f, t, p);
        if in_check(side) {
            sound::play("check");
        } else {
            if captured != 0 {
                sound::play("capture");
            } else {
                sound::play("move");
            }
        }
        finish();
        draw();
    }

    /// The game is over: the board with the card stamped over it, and the two
    /// things that stamp by themselves stopped first.
    ///
    /// [`over`] in the HUD is stamped once, after the board has drawn, so anything
    /// that stamps a frame later is stamped on top of the card: a piece still
    /// travelling paints the squares it crosses and itself over the result, and
    /// the evaluation bar keeps moving over the veil. Both stop here, so the
    /// piece that played the last move is drawn at rest on its square by the
    /// `draw` that follows, and nothing follows the card.
    proc over_page() warp {
        mode = 3;
        aon = 0;
        adrag = 0;
        ahide = 0;
        eon = 0;
    }

    /// Decide whose turn it is, or that there is no turn left.
    proc finish() warp {
        legal();
        curreps = hist[(histn - 1) * SLOT + SLOT];
        checking = 0;
        if nok == 0 {
            over_page();
            reason = 2;
            winner = -1;
            hint = "STALEMATE";
            if in_check(side) {
                reason = 1;
                winner = 1 - side;
                hint = "CHECKMATE";
            }
            sound::play("end");
            return;
        }
        if rule50 >= 100 {
            over_page();
            reason = 3;
            winner = -1;
            hint = "DRAW";
            sound::play("end");
            return;
        }
        if curreps >= 2 {
            over_page();
            reason = 4;
            winner = -1;
            hint = "DRAW";
            sound::play("end");
            return;
        }
        if in_check(side) { checking = king_of(side); }
        if is_bot(side) {
            mode = 2;
            hint = "THINKING";
        } else {
            mode = 1;
            hint = "YOUR MOVE";
        }
        if checking != 0 { hint = "CHECK"; }
    }

    proc bot_turn() warp {
        ensure_bot();
        // Both of these can be seconds long, and the panel's buttons are heard
        // while they run: the way back to the menu is acted on by the board's
        // other thread, so a game that has been left is not moved into.
        if page != 1 { return; }
        legal();
        if nok == 0 {
            finish();
            draw();
            return;
        }
        wdlside = side;
        sample_move();
        if page != 1 { return; }
        etarget = wdl[1] + wdl[2] / 2;
        if wdlside == 1 { etarget = 1 - etarget; }
        eprev = etarget;
        elast = sensing::timer();
        eon = 1;
        if bestf != 0 {
            play(bestf, bestt, bestp);
        } else {
            mode = 1;
            hint = "YOUR MOVE";
            draw();
        }
    }

    proc new_game() warp {
        // Show the wait before taking it: unpacking a bot is a few seconds of
        // adding to two lists, and the loop cannot redraw while it runs.
        page = 1;
        mode = 1;
        hint = "LOADING";
        draw();
        human = 0;
        if wseat != 0 && bseat == 0 { human = 1; }
        flipped = human;
        winner = -1;
        reason = 0;
        sel = 0;
        promosq = 0;
        hover = 0;
        lastf = 0;
        lastt = 0;
        checking = 0;
        curreps = 0;
        aon = 0;
        adrag = 0;
        ahide = 0;
        capw.clear();
        capb.clear();
        log.clear();
        eshare = 0.5;
        etarget = 0.5;
        eprev = 0.5;
        evv = 0;
        eon = 0;
        t0 = sensing::timer();
        secs = 0;
        ensure_bot();
        // The MENU button, pressed while the weights were unpacking: the game
        // this was setting up is not the page any more, so it is not dealt.
        if page != 1 { return; }
        start_board();
        legal();
        if is_bot(side) {
            mode = 2;
            hint = "THINKING";
        } else {
            mode = 1;
            hint = "YOUR MOVE";
        }
        sound::play("start");
        draw();
    }

    // -----------------------------------------------------------------------
    // The mouse
    // -----------------------------------------------------------------------

    fn in_box(x: num, y: num, cx: num, cy: num, hw: num, hh: num) -> bool {
        x >= cx - hw && x <= cx + hw && y >= cy - hh && y <= cy + hh
    }

    /// Whether a point is on one of the panel's three buttons. They are heard as
    /// events — see `buttons_click` — so a press on one is not also one of the
    /// presses the loop samples, and this is what tells the two apart.
    fn on_buttons(x: num, y: num) -> bool {
        in_box(x, y, NEW_X, P_BTN, BTN_HW, BTN_HH) ||
            in_box(x, y, FLIP_X, P_BTN, BTN_HW, BTN_HH) ||
            in_box(x, y, MENU_X, P_BTN, BTN_HW, BTN_HH)
    }

    /// The square at a screen row and column: the board as it is drawn, which is
    /// the board as it is played only while it is not turned round. Everything
    /// that reads a position off the stage goes through this -- the pointer, and
    /// the box a flight repaints as it crosses it.
    proc screen_cell(row: num, col: num) -> num warp {
        let r = row;
        let c = col;
        if flipped == 1 {
            r = 7 - r;
            c = 7 - c;
        }
        return cell(r, c);
    }

    proc cell_at(x: num, y: num) -> num warp {
        if x < EDGE_X || x >= EDGE_X + 8 * SQUARE { return 0; }
        if y < EDGE_Y || y >= EDGE_Y + 8 * SQUARE { return 0; }
        return screen_cell(floor((y - EDGE_Y) / SQUARE), floor((x - EDGE_X) / SQUARE));
    }

    /// Pick a piece up: it starts following the pointer from where it stands.
    proc begin_drag(m: num, mx: num, my: num) warp {
        afrom = m;
        apiece = board[atc(m)];
        ahide = m;
        ax = raw_x(m);
        ay = raw_y(m);
        avx = 0;
        avy = 0;
        atx = fx(mx);
        aty = fy(my);
        apx = atx;
        apy = aty;
        af = 7;
        az = 0.9;
        ar = 0;
        alast = sensing::timer();
        aon = 1;
        adrag = 1;
        stamp_flight();
    }

    proc promo_click(x: num, y: num) warp {
        let base = promo_base();
        let col = screen_col(promosq);
        if x < LEFT + col * SQUARE - SQUARE / 2 { return; }
        if x >= LEFT + col * SQUARE + SQUARE / 2 { return; }
        let row = floor((y - EDGE_Y) / SQUARE);
        if row < base || row >= base + 4 { return; }
        // The strip is drawn queen first, so the row picked is the kind in the
        // same order down the four legal promotion moves.
        play(sel, promosq, 5 - (row - base));
    }

    proc seat_set(s: num, i: num) warp {
        let v = bseat;
        if s == 0 { v = wseat; }
        if i != v {
            if s == 0 {
                wseat = i;
            } else {
                bseat = i;
            }
            draw();
        }
    }

    /// The menu: the button under the two rows starts the game, the one beside
    /// it opens the settings, and a press on a seat takes it. A seat is one
    /// press and no drag: the row is a row of choices, not a value to aim at.
    proc menu_click(x: num, y: num) warp {
        if in_box(x, y, M_PLAY_X, M_PLAY, M_PLAY_HW, M_PLAY_HH) {
            new_game();
            return;
        }
        if in_box(x, y, M_SET_X, M_PLAY, M_PLAY_HW, M_PLAY_HH) {
            page = 2;
            hover = 0;
            draw();
            return;
        }
        for s in 0..2 {
            let cy = M_CARD_A;
            if s == 1 { cy = M_CARD_B; }
            if in_box(x, y, 0, cy, M_CARD_HW, M_CARD_HH) {
                for i in 0..M_SEAT_N {
                    if in_box(x, y, M_SEAT_X0 + i * M_SEAT_DX, cy, M_SEAT_HALF, M_CARD_HH) {
                        seat_set(s, i);
                        return;
                    }
                }
                return;
            }
        }
    }

    /// The settings page: a grid of the piece sets, a row of the board styles,
    /// and a way back.
    proc settings_click(x: num, y: num) warp {
        if in_box(x, y, M_BACK_X, M_BACK_Y, M_PLAY_HW, M_PLAY_HH) {
            page = 0;
            hover = 0;
            draw();
            return;
        }
        for i in 0..SET_N {
            let col = i % S_COLS;
            let row = floor(i / S_COLS);
            if in_box(x, y, S_GRID_X + col * S_STEP, S_GRID_Y - row * S_STEP, S_HALF, S_HALF) {
                if pset != i {
                    pset = i;
                    draw();
                }
                return;
            }
        }
        for i in 0..4 {
            if in_box(x, y, B_ROW_X + i * B_ROW_DX, B_ROW_Y, B_ROW_W / 2, S_HALF) {
                if bstyle != i {
                    bstyle = i;
                    draw();
                }
                return;
            }
        }
    }

    /// Back to the menu, abandoning whatever game was on: the page is the menu,
    /// the game is over as far as the board is concerned, and the next press of
    /// PLAY deals a new one. The state a page needs is left where the menu wants
    /// it, so the board is not one press away from a game it is no longer in.
    proc to_menu() warp {
        page = 0;
        mode = 0;
        hint = "PICK A SEAT AND PLAY";
        sel = 0;
        promosq = 0;
        hover = 0;
        aon = 0;
        adrag = 0;
        ahide = 0;
        draw();
    }

    /// The panel's three buttons, as a press at `x`, `y`: a new game, turning the
    /// board round, and the way back to the menu. They are the game page's, and
    /// they are heard as events rather than sampled — see the flag script below.
    proc buttons_click(x: num, y: num) warp {
        if page != 1 { return; }
        if in_box(x, y, MENU_X, P_BTN, BTN_HW, BTN_HH) {
            to_menu();
            return;
        }
        if in_box(x, y, NEW_X, P_BTN, BTN_HW, BTN_HH) {
            new_game();
            return;
        }
        if in_box(x, y, FLIP_X, P_BTN, BTN_HW, BTN_HH) {
            flipped = 1 - flipped;
            hover = 0;
            draw();
        }
    }

    /// What a press on the game page means: a promotion choice, one of your own
    /// pieces or a square to move one to. The panel's buttons are not here —
    /// they are events, and `buttons_click` is where they land.
    proc press(mx: num, my: num) warp {
        if page == 0 {
            menu_click(mx, my);
            return;
        }
        if page == 2 {
            settings_click(mx, my);
            return;
        }
        // The panel's buttons are the button thread's, whatever the mode: this is
        // the loop's sample of the mouse, and the same press is not both.
        if on_buttons(mx, my) { return; }
        // A press on the end-of-game card: its buttons are the panel's, below it,
        // and a press anywhere else is the invitation the card prints.
        if mode == 3 {
            to_menu();
            return;
        }
        if mode != 1 { return; }
        if promosq != 0 {
            promo_click(mx, my);
            return;
        }
        let m = cell_at(mx, my);
        if m == 0 { return; }
        if mine(board[atc(m)], side) {
            sel = m;
            begin_drag(m, mx, my);
            draw();
            return;
        }
        if sel != 0 && can_move(sel, m) {
            if promotion_of(sel, m) != 0 {
                promosq = m;
                draw();
                return;
            }
            play(sel, m, 0);
            return;
        }
        if sel != 0 {
            sel = 0;
            draw();
        }
    }

    /// Let go: play the move if the square under the pointer takes one, and
    /// otherwise let the piece fall back where it came from. Either way it stays
    /// picked up, because a press that did not move is a click and the dots on
    /// its destinations are what a click is for.
    proc release(mx: num, my: num) warp {
        if adrag == 0 { return; }
        adrag = 0;
        let m = cell_at(mx, my);
        if m != 0 && m != afrom && can_move(afrom, m) {
            if promotion_of(afrom, m) != 0 {
                sel = afrom;
                promosq = m;
                aim(afrom, 5.5, 0.95, 0);
                draw();
                return;
            }
            play(afrom, m, 0);
            return;
        }
        sel = afrom;
        aim(afrom, 5.5, 0.95, 0);
        draw();
    }

    /// One pass of the pointer: press, release, and where it is while it is held.
    proc pointer() warp {
        let down = sensing::mouse_down();
        let mx = sensing::mouse_x();
        let my = sensing::mouse_y();
        if down {
            if held == 0 {
                held = 1;
                press(mx, my);
            }
        } else {
            if held == 1 {
                held = 0;
                release(mx, my);
            }
        }
        // The piece is stamped, so it is kept on the board: a flight over the
        // panel could not be painted back without redrawing the page.
        if adrag == 1 {
            atx = fx(mx);
            aty = fy(my);
            if atx < EDGE_X + SQUARE / 2 { atx = EDGE_X + SQUARE / 2; }
            if atx > EDGE_X + 8 * SQUARE - SQUARE / 2 { atx = EDGE_X + 8 * SQUARE - SQUARE / 2; }
            if aty < EDGE_Y + SQUARE / 2 { aty = EDGE_Y + SQUARE / 2; }
            if aty > EDGE_Y + 8 * SQUARE - SQUARE / 2 { aty = EDGE_Y + 8 * SQUARE - SQUARE / 2; }
        }
    }

    /// The pointer's square while the game is waiting for it. A hover that
    /// crosses a line repaints the two squares it crossed and nothing else,
    /// which is why a moving pointer never costs a redraw of the panel.
    proc track_hover() warp {
        let m = cell_at(sensing::mouse_x(), sensing::mouse_y());
        if m != hover {
            let old = hover;
            hover = m;
            // Nothing is repainted while a piece is in flight: painting is
            // stamping, and stamping would drag the sprite off the piece.
            if promosq == 0 && aon == 0 {
                if old != 0 { paint_square(old); }
                if m != 0 { paint_square(m); }
                looks::set_size_to(100);
            }
        }
    }

    // -----------------------------------------------------------------------
    // The check
    // -----------------------------------------------------------------------

    // `tools/check.mjs` loads the built project, writes the position it wants
    // into the engine's own lists, presses one of these, and reads `test` back.
    // They are the only way to run the engine without a mouse, and the game
    // itself never presses them. `load[678]` is the perft depth and `load[680]`
    // is the bot to unpack.

    /// A move, packed so that one list can carry a whole legal move list.
    fn pack(f: num, t: num, p: num) -> num {
        (f * 100 + t) * 10 + p
    }

    /// Put a position into the engine's own lists: the 120 board cells, then
    /// side, castling, en passant, the fifty move clock, how many history slots
    /// there are, the slots themselves, the perft depth and the bot.
    on key_pressed(Key::S) {
        for i in 0..120 { board[atc(i)] = load[i + 1]; }
        side = load[121];
        castle = load[122];
        ep = load[123];
        rule50 = load[124];
        histn = load[125];
        let n = histn * SLOT;
        for i in 0..n { hist[i + 1] = load[126 + i]; }
        // The check plays every position with the bot it named, on either side.
        wseat = load[680] + 1;
        bseat = load[680] + 1;
        bot = -1;
        aon = 0;
        adrag = 0;
        ahide = 0;
    }

    on key_pressed(Key::L) {
        legal();
        test.clear();
        test.push(nok);
        for i in 0..nok {
            test.push(pack(okf[i + 1], okt[i + 1], okp[i + 1]));
        }
    }

    on key_pressed(Key::T) {
        test.clear();
        test.push(perft(load[678]));
    }

    on key_pressed(Key::Y) {
        ensure_bot();
        legal();
        best_move();
        test.clear();
        test.push(bestf);
        test.push(bestt);
        test.push(bestp);
        test.push(wdl[1]);
        test.push(wdl[2]);
        test.push(wdl[3]);
    }

    /// Unpack a bot. Its two lists are Scratch lists on the stage, so the check
    /// reads them where they are; this only says when they are ready.
    on key_pressed(Key::B) {
        load_bot(load[680]);
        test.clear();
        test.push(w.len());
        test.push(b.len());
    }


    on flag_clicked {
        setup();
        page = 0;
        mode = 0;
        wseat = 0;
        bseat = 1;
        human = 0;
        flipped = 0;
        winner = -1;
        reason = 0;
        hint = "PICK A SEAT AND PLAY";
        sel = 0;
        promosq = 0;
        hover = 0;
        lastf = 0;
        lastt = 0;
        checking = 0;
        aon = 0;
        adrag = 0;
        ahide = 0;
        capw.clear();
        capb.clear();
        log.clear();
        eshare = 0.5;
        etarget = 0.5;
        eprev = 0.5;
        evv = 0;
        eon = 0;
        alast = sensing::timer();
        elast = alast;
        t0 = alast;
        secs = 0;
        looks::hide();
        looks::set_size_to(100);
        start_board();
        draw();
        forever {
            // The board is only the board while the board is the page. A piece
            // in flight is stamped where the system carries it — the squares it
            // has left are painted back under it — so a frame of it is a dozen
            // stamps and no clear at all.
            if page == 1 {
                if aon == 1 { anim_frame(); }
                if eon == 1 {
                    eval_frame();
                    events::broadcast("eval");
                }
                if mode == 1 {
                    if adrag == 0 { track_hover(); }
                    pointer();
                }
                // A bot thinks for a long time inside one frame, so it is not
                // started until the piece it is answering has finished moving:
                // otherwise the move it just made freezes half way there.
                if mode == 2 && aon == 0 { bot_turn(); }
                if mode == 3 { pointer(); }
                // The clock is `engine`'s, because this loop does not get a turn
                // while a bot is thinking or while one is being unpacked.
                if mode != 0 { clock_tick(); }
            } else {
                pointer();
            }
            control::wait(0.025);
        }
    }

    /// The panel's buttons, acted on from a thread of the board's own.
    ///
    /// A bot's turn runs inside one frame of the loop above, so while a bot is
    /// thinking — which, in a game between two bots, is nearly all of the time —
    /// that loop is not there to notice a press on a button, and a press that
    /// comes and goes inside the window would be lost. The stage hears the click
    /// as an event and leaves it in `click_x`, `click_y` and `click_at`; this is
    /// the thread that gets a turn during a search, and it is what acts on it.
    on flag_clicked {
        forever {
            if click_at != seen_click {
                seen_click = click_at;
                buttons_click(click_x, click_y);
            }
            control::wait(0.05);
        }
    }
}
