/// The costume of piece `p` (1 pawn .. 12 king, white then black) in set
/// `theme`, at the size it is about to be stamped at. Out of range pieces
/// are the transparent pixel both sprites park on.
pub proc take(theme: num, p: num, size: num) warp {
    match theme {
        0 => { set0(p, size); },
        1 => { set1(p, size); },
        2 => { set2(p, size); },
        3 => { set3(p, size); },
        4 => { set4(p, size); },
        5 => { set5(p, size); },
        6 => { set6(p, size); },
        7 => { set7(p, size); },
        8 => { set8(p, size); },
        9 => { set9(p, size); },
        10 => { set10(p, size); },
        11 => { set11(p, size); },
        12 => { set12(p, size); },
        13 => { set13(p, size); },
        14 => { set14(p, size); },
        15 => { set15(p, size); },
        16 => { set16(p, size); },
        17 => { set17(p, size); },
        18 => { set18(p, size); },
        19 => { set19(p, size); },
        20 => { set20(p, size); },
        21 => { set21(p, size); },
        22 => { set22(p, size); },
        23 => { set23(p, size); },
        24 => { set24(p, size); },
        25 => { set25(p, size); },
        26 => { set26(p, size); },
        27 => { set27(p, size); },
        28 => { set28(p, size); },
        29 => { set29(p, size); },
        30 => { set30(p, size); },
        31 => { set31(p, size); },
        32 => { set32(p, size); },
        33 => { set33(p, size); },
        34 => { set34(p, size); },
        35 => { set35(p, size); },
        36 => { set36(p, size); },
        37 => { set37(p, size); },
        38 => { set38(p, size); },
        _ => { looks::switch_costume_to("blank"); }
    }
}
