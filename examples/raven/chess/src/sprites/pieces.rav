// Which costume a piece of a set is drawn with. Generated by tools/assets.mjs.
//
// A costume's name is a literal in raven, so the costume of a theme, a piece
// and a size cannot be combined into one any other way than an arm each:
// 39 sets of twelve pieces of 4 sizes.
// One procedure per set, chosen by a match on the set, because a single match
// with every pair in it is deeper than the compiler can lower.
//
// `size` is the size the piece is going to be stamped at, and the costumes
// are that size: a piece on the board, one the pointer is holding, an icon in
// the panel's capture row and a knight in the settings grid.
//   0  p  36 units
//   1  d  40 units
//   2  c  24 units
//   3  s  22 units

pub proc set0(p: num, size: num) warp {
    match size {
        0 => {
            match p {
                1 => { looks::switch_costume_to("p0wP"); },
                2 => { looks::switch_costume_to("p0wN"); },
                3 => { looks::switch_costume_to("p0wB"); },
                4 => { looks::switch_costume_to("p0wR"); },
                5 => { looks::switch_costume_to("p0wQ"); },
                6 => { looks::switch_costume_to("p0wK"); },
                7 => { looks::switch_costume_to("p0bP"); },
                8 => { looks::switch_costume_to("p0bN"); },
                9 => { looks::switch_costume_to("p0bB"); },
                10 => { looks::switch_costume_to("p0bR"); },
                11 => { looks::switch_costume_to("p0bQ"); },
                12 => { looks::switch_costume_to("p0bK"); },
                _ => { looks::switch_costume_to("blank"); }
            }
        },
        1 => {
            match p {
                1 => { looks::switch_costume_to("d0wP"); },
                2 => { looks::switch_costume_to("d0wN"); },
                3 => { looks::switch_costume_to("d0wB"); },
                4 => { looks::switch_costume_to("d0wR"); },
                5 => { looks::switch_costume_to("d0wQ"); },
                6 => { looks::switch_costume_to("d0wK"); },
                7 => { looks::switch_costume_to("d0bP"); },
                8 => { looks::switch_costume_to("d0bN"); },
                9 => { looks::switch_costume_to("d0bB"); },
                10 => { looks::switch_costume_to("d0bR"); },
                11 => { looks::switch_costume_to("d0bQ"); },
                12 => { looks::switch_costume_to("d0bK"); },
                _ => { looks::switch_costume_to("blank"); }
            }
        },
        2 => {
            match p {
                1 => { looks::switch_costume_to("c0wP"); },
                2 => { looks::switch_costume_to("c0wN"); },
                3 => { looks::switch_costume_to("c0wB"); },
                4 => { looks::switch_costume_to("c0wR"); },
                5 => { looks::switch_costume_to("c0wQ"); },
                6 => { looks::switch_costume_to("c0wK"); },
                7 => { looks::switch_costume_to("c0bP"); },
                8 => { looks::switch_costume_to("c0bN"); },
                9 => { looks::switch_costume_to("c0bB"); },
                10 => { looks::switch_costume_to("c0bR"); },
                11 => { looks::switch_costume_to("c0bQ"); },
                12 => { looks::switch_costume_to("c0bK"); },
                _ => { looks::switch_costume_to("blank"); }
            }
        },
        3 => {
            match p {
                1 => { looks::switch_costume_to("s0wP"); },
                2 => { looks::switch_costume_to("s0wN"); },
                3 => { looks::switch_costume_to("s0wB"); },
                4 => { looks::switch_costume_to("s0wR"); },
                5 => { looks::switch_costume_to("s0wQ"); },
                6 => { looks::switch_costume_to("s0wK"); },
                7 => { looks::switch_costume_to("s0bP"); },
                8 => { looks::switch_costume_to("s0bN"); },
                9 => { looks::switch_costume_to("s0bB"); },
                10 => { looks::switch_costume_to("s0bR"); },
                11 => { looks::switch_costume_to("s0bQ"); },
                12 => { looks::switch_costume_to("s0bK"); },
                _ => { looks::switch_costume_to("blank"); }
            }
        },
        _ => { looks::switch_costume_to("blank"); }
    }
}

